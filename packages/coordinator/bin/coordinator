#!/usr/bin/env bash
set -uo pipefail

# Coordinator binary: claim/submit/merge-next flow for wt/<slug> work.
# Uses plain git (no GitHub). State lives in .term/coordinator/state.json (main repo).
#
# Merge safety invariants (see docs/parallel-work.md):
#   1. Uncommitted bytes are never destroyed. Any worktree removal first stashes the
#      non-exempt dirt into a named ref (refs/coordinator/saved/<slug>-<ts>) and prints
#      recovery commands. Only .term/coordinator/state.json dirt is exempt.
#   2. Merge work happens in dedicated worktrees (worktree/wt-merge-check-*), never in
#      the main checkout. The main checkout must be on dev and tracked-clean at the
#      start of a merge step and is fast-forwarded onto the verified scratch branch.
#   3. Submit enforces the lease's claimed paths against the commits on the branch;
#      override with submit --force (logged to the lease record).
#   4. The SPEC.md spec-check marker is re-counted by merge-next itself on the merged
#      tree (scripts/spec-check.ts --write), never by hand.

find_root() {
  git rev-parse --show-toplevel 2>/dev/null || pwd
}

find_main_root() {
  local main
  main=$(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2; exit}')
  if [ -n "${main:-}" ] && [ -d "$main" ]; then
    printf '%s\n' "$main"
  else
    find_root
  fi
}

MAIN_ROOT=$(find_main_root)
ROOT=$(find_root)
DATA_DIR="$MAIN_ROOT/.term/coordinator"
CONFIG_FILE="$DATA_DIR/config.json"
STATE_FILE="$DATA_DIR/state.json"

DEV_BRANCH="dev"
WORKTREE_DIR="worktree"
SHARED_PATHS_DEFAULT=".term/coordinator/state.json,docs/changelog.html"

read_config() {
  DEV_BRANCH="dev"
  WORKTREE_DIR="worktree"
  SHARED_PATHS="$SHARED_PATHS_DEFAULT"
  if [ -f "$CONFIG_FILE" ]; then
    if command -v jq >/dev/null 2>&1; then
      DEV_BRANCH=$(jq -r '.devBranch // "dev"' "$CONFIG_FILE" 2>/dev/null || printf 'dev')
      WORKTREE_DIR=$(jq -r '.worktreeDir // "worktree"' "$CONFIG_FILE" 2>/dev/null || printf 'worktree')
      SHARED_PATHS=$(jq -r '.sharedPaths // ".term/coordinator/state.json,docs/changelog.html"' "$CONFIG_FILE" 2>/dev/null || printf '%s' "$SHARED_PATHS_DEFAULT")
    else
      local v
      v=$(grep -o '"devBranch"[[:space:]]*:[[:space:]]*"[^"]*"' "$CONFIG_FILE" 2>/dev/null | sed -E 's/.*"devBranch"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/' | head -1)
      [ -n "$v" ] && DEV_BRANCH="$v"
      v=$(grep -o '"worktreeDir"[[:space:]]*:[[:space:]]*"[^"]*"' "$CONFIG_FILE" 2>/dev/null | sed -E 's/.*"worktreeDir"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/' | head -1)
      [ -n "$v" ] && WORKTREE_DIR="$v"
      v=$(grep -o '"sharedPaths"[[:space:]]*:[[:space:]]*"[^"]*"' "$CONFIG_FILE" 2>/dev/null | sed -E 's/.*"sharedPaths"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/' | head -1)
      [ -n "$v" ] && SHARED_PATHS="$v"
    fi
    [ -z "$DEV_BRANCH" ] && DEV_BRANCH="dev"
    [ -z "$WORKTREE_DIR" ] && WORKTREE_DIR="worktree"
    [ -z "$SHARED_PATHS" ] && SHARED_PATHS="$SHARED_PATHS_DEFAULT"
  fi
  # Legacy fallback: an old config (or an old lease path) still selects "worktrees".
  # Honour it — old leases must stay valid — but warn once per repo about the migration.
  warn_legacy_worktree_dir
}

LEGACY_WORKTREE_DIR="worktrees"
LEGACY_WARN_FILE="$DATA_DIR/.legacy-worktree-warned"

warn_legacy_worktree_dir() {
  [ "${WORKTREE_DIR:-}" != "$LEGACY_WORKTREE_DIR" ] && return 0
  [ -f "$LEGACY_WARN_FILE" ] && return 0
  printf 'warning: config uses legacy worktree dir "%s"; it still works, but run "coordinator migrate-worktree-dir" to move to "worktree"\n' "$LEGACY_WORKTREE_DIR" >&2
  printf '%s\n' "$(now_iso)" > "$LEGACY_WARN_FILE" 2>/dev/null || true
}

warn_legacy_lease_path() {
  case "${1:-}" in
    worktrees/*) warn_legacy_worktree_dir ;;
    *) return 0 ;;
  esac
}

need_jq() {
  if ! command -v jq >/dev/null 2>&1; then
    printf 'error: jq is required for coordinator state\n' >&2
    exit 1
  fi
}

ensure_state() {
  mkdir -p "$DATA_DIR"
  if [ ! -f "$STATE_FILE" ]; then
    local tmp
    tmp=$(mktemp "$DATA_DIR/.state.XXXXXX") || { printf 'error: mktemp failed\n' >&2; exit 1; }
    printf '{"version":1,"leases":{},"mergeLock":null}\n' > "$tmp" || {
      rm -f "$tmp"
      printf 'error: could not initialize %s (write failed)\n' "$STATE_FILE" >&2
      exit 1
    }
    chmod 644 "$tmp" 2>/dev/null || true
    mv "$tmp" "$STATE_FILE" || {
      rm -f "$tmp"
      printf 'error: could not initialize %s (rename failed)\n' "$STATE_FILE" >&2
      exit 1
    }
  fi
}

# One mutex for every state write/read-modify-write: $DATA_DIR/.state.lock.
# Callers that need to read, decide, and write atomically hold the lock across
# the whole critical section and re-read $STATE_FILE while holding it.
state_lock() {
  mkdir -p "$DATA_DIR"
  exec 8<>"$DATA_DIR/.state.lock" || { printf 'error: cannot open state lock\n' >&2; exit 1; }
  if command -v flock >/dev/null 2>&1; then flock 8 || { printf 'error: cannot lock state\n' >&2; exit 1; }; fi
}

state_unlock() {
  if command -v flock >/dev/null 2>&1; then flock -u 8 2>/dev/null || true; fi
  { exec 8>&-; } 2>/dev/null || true
}

# Write while the caller already holds the state lock. Re-reads $STATE_FILE.
state_write_filter() {
  local tmp
  tmp=$(mktemp "$DATA_DIR/.state.XXXXXX") || { printf 'error: mktemp failed\n' >&2; exit 1; }
  if ! jq "$@" "$STATE_FILE" > "$tmp"; then
    rm -f "$tmp"
    printf 'error: failed to update coordinator state\n' >&2
    exit 1
  fi
  chmod 644 "$tmp" 2>/dev/null || true
  # Test hook: widen the critical section to exercise concurrency deterministically.
  if [ -n "${COORDINATOR_TEST_STATE_WRITE_SLEEP:-}" ]; then
    sleep "$COORDINATOR_TEST_STATE_WRITE_SLEEP"
  fi
  mv -f "$tmp" "$STATE_FILE" || {
    rm -f "$tmp"
    printf 'error: failed to move coordinator state into place\n' >&2
    exit 1
  }
}

# Atomic state write: acquires the state mutex, re-reads, applies jq filter, mv -f.
# Route all mutations through this helper (or state_write_filter under an already-held lock).
state_jq() {
  state_lock
  state_write_filter "$@"
  state_unlock
}

slugify() {
  local s
  s=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/-{2,}/-/g')
  if [ -z "$s" ]; then s="task"; fi
  printf '%s' "$s"
}

now_iso() {
  date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf '1970-01-01T00:00:00Z'
}

now_epoch() {
  date -u +%s 2>/dev/null || printf '0'
}

iso_to_epoch() {
  date -u -d "$1" +%s 2>/dev/null || printf '0'
}

# Normalize .mergeLock, which may be a legacy string slug or the current object.
merge_lock_slug() {
  jq -r 'if (.mergeLock|type) == "object" then .mergeLock.slug // "" elif .mergeLock then .mergeLock else "" end' "$STATE_FILE" 2>/dev/null
}

# --- merge lock observability (read-only) -----------------------------------
# do_merge_next records the holder under the existing flock as one line:
#   slug=<slug> branch=<branch> pid=<pid> started=<ISO8601>
# These helpers only READ that record and the state mirror. They never take the
# exclusive lock, never write state, and never clear a lock — merge-status is safe
# to call at any time, including from another agent's worktree while a merge runs.
merge_holder_line() {
  cat "$DATA_DIR/.merge-lock/holder" 2>/dev/null || cat "$DATA_DIR/.merge-lock-file" 2>/dev/null || true
}

merge_holder_field() {
  printf '%s\n' "$1" | tr ' ' '\n' | sed -n "s/^$2=//p" | head -1
}

merge_holder_alive() {
  case "${1:-}" in
    ''|*[!0-9]*) return 1 ;;
  esac
  kill -0 "$1" 2>/dev/null
}

# True when the existing merge-lock flock can be acquired non-blockingly.
merge_lock_free() {
  local lock_file="$DATA_DIR/.merge-lock-file"
  exec 9<>"$lock_file" 2>/dev/null || return 1
  if command -v flock >/dev/null 2>&1; then
    if ! flock -n 9; then { exec 9>&-; } 2>/dev/null || true; return 1; fi
    flock -u 9 2>/dev/null || true
  fi
  { exec 9>&-; } 2>/dev/null || true
  return 0
}

# Emit the read-only merge-status JSON: mergeInProgress, holder, ageSeconds,
# recommendation. A live holder means "wait"; a dead pid or a lock past the
# 60-minute reclaim window means "stale, merge-next will reclaim it".
merge_status_json() {
  need_jq
  local line slug pid started age=0 state_slug
  line=$(merge_holder_line); line=${line%$'\n'}
  slug=$(merge_holder_field "$line" slug)
  pid=$(merge_holder_field "$line" pid)
  started=$(merge_holder_field "$line" started)
  state_slug=$(merge_lock_slug)
  [ -z "$slug" ] && slug="$state_slug"
  if [ -z "$started" ] && [ -n "$state_slug" ]; then
    started=$(jq -r --arg s "$state_slug" '.mergeLock.startedAt // empty' "$STATE_FILE" 2>/dev/null || true)
  fi
  if [ -n "$started" ]; then
    local epoch
    epoch=$(iso_to_epoch "$started")
    if [ "${epoch:-0}" -gt 0 ]; then
      age=$(( $(now_epoch) - epoch ))
      [ "$age" -lt 0 ] && age=0
    fi
  fi
  if [ "$age" -eq 0 ] && [ -d "$DATA_DIR/.merge-lock" ]; then
    local mtime
    mtime=$(stat -c %Y "$DATA_DIR/.merge-lock" 2>/dev/null || printf '0')
    if [ "${mtime:-0}" -gt 0 ]; then
      age=$(( $(now_epoch) - mtime ))
      [ "$age" -lt 0 ] && age=0
    fi
  fi

  local rec held=false holder_json=null
  if [ -n "$slug" ]; then
    held=true
    holder_json=$(jq -nc --arg s "$slug" '$s')
    if [ -z "$pid" ]; then
      rec="merge lock held by $slug (holder pid unknown, age ${age}s) — verify the merge is alive; await-merge can wait it out"
    elif merge_holder_alive "$pid"; then
      if [ "$age" -gt 3600 ]; then
        rec="stale merge lock held by $slug (pid $pid alive, age ${age}s > 3600s) — merge-next will reclaim it; proceed with care"
      else
        rec="merge in progress by $slug (pid $pid, age ${age}s) — wait with await-merge before claim/submit/merge-next"
      fi
    else
      rec="stale lock held by dead pid $pid ($slug, age ${age}s) — merge-next will reclaim it; safe to retry"
    fi
  else
    rec="clear — no merge in progress; you may claim, submit, or merge-next"
  fi
  jq -nc --argjson mip "$held" --argjson holder "$holder_json" --argjson age "$age" --arg rec "$rec" \
    '{mergeInProgress:$mip, holder:$holder, ageSeconds:$age, recommendation:$rec}'
}

do_merge_status() {
  need_jq
  ensure_state
  read_config
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)
        printf 'usage: coordinator merge-status\n\n  Read-only view of the existing merge lock as JSON: mergeInProgress, holder, ageSeconds, recommendation.\n'
        return 0 ;;
      *) printf 'unknown merge-status option: %s\n' "$1" >&2; return 1 ;;
    esac
  done
  merge_status_json
}

# Poll the existing merge lock (no new lock system) until no live merge holds it.
# Prints a final merge-status JSON; exit 0 when clear, 1 on timeout/error.
do_await_merge() {
  need_jq
  ensure_state
  read_config
  local timeout=300 deadline
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout) timeout="${2:-}"; shift 2 ;;
      --timeout=*) timeout="${1#*=}"; shift ;;
      -h|--help)
        printf 'usage: coordinator await-merge [--timeout SECONDS]\n\n  Poll the existing merge lock until it is free, then print merge-status JSON. Exit 1 on timeout.\n'
        return 0 ;;
      *) printf 'unknown await-merge option: %s\n' "$1" >&2; return 1 ;;
    esac
  done
  case "$timeout" in ''|*[!0-9]*) printf 'error: --timeout must be a non-negative integer\n' >&2; return 1 ;; esac
  deadline=$(( $(now_epoch) + timeout ))
  while :; do
    local status mip line pid
    status=$(merge_status_json) || return 1
    mip=$(printf '%s' "$status" | jq -r '.mergeInProgress')
    if [ "$mip" = "false" ]; then printf '%s\n' "$status"; return 0; fi
    # A stale/dead holder does not block: when the underlying flock is also free,
    # the lock is safe to reclaim and await-merge returns immediately.
    line=$(merge_holder_line); line=${line%$'\n'}
    pid=$(merge_holder_field "$line" pid)
    if [ -n "$pid" ] && ! merge_holder_alive "$pid" && merge_lock_free; then
      printf '%s\n' "$status"
      return 0
    fi
    if [ "$(now_epoch)" -ge "$deadline" ]; then
      printf '%s\n' "$status"
      printf 'error: timed out after %ss waiting for merge lock\n' "$timeout" >&2
      return 1
    fi
    sleep 1
  done
}

# Trim leading/trailing whitespace.
trim() {
  printf '%s' "$1" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//'
}

# path_in_scopes <file> <comma-separated-scopes> — segment-boundary prefix match.
#   "packages/coordinator/**" matches packages/coordinator and everything below it
#   "src/core/types.ts"       matches exactly that file
#   "test"                    matches test and everything below it
#   "."                       matches everything
# A scope's trailing "/**" or "/*" is stripped before comparing.
path_in_scopes() {
  local f="$1" raw s
  local IFS=$', \t\n'
  read -ra scopes <<<"$2"
  for raw in "${scopes[@]}"; do
    s=$(trim "$raw")
    [ -z "$s" ] && continue
    s="${s%/}"
    s="${s%/\*\*}"
    s="${s%/\*}"
    s="${s%/}"
    [ -z "$s" ] && continue
    if [ "$s" = "." ]; then return 0; fi
    if [ "$f" = "$s" ]; then return 0; fi
    case "$f" in
      "$s"/*) return 0 ;;
    esac
  done
  return 1
}

# dirty_count <abs-worktree-path> — porcelain count, excluding the sanctioned
# state.json dirt. Prints a number, or "x" when the path is not a worktree.
dirty_count() {
  local wt="$1"
  [ -d "$wt" ] || { printf 'x\n'; return; }
  git -C "$wt" rev-parse --is-inside-work-tree >/dev/null 2>&1 || { printf 'x\n'; return; }
  git -C "$wt" status --porcelain -- . ':(exclude).term/coordinator/state.json' 2>/dev/null | wc -l | tr -d ' '
}

# Stash the non-exempt dirt of a worktree into a named ref so the bytes survive
# worktree removal. Returns 0 when the worktree is (now) clean of non-exempt dirt.
preserve_dirt() {
  local wt="$1" slug="$2" ts ref sha
  ts=$(now_epoch)
  ref="refs/coordinator/saved/${slug}-${ts}"
  (cd "$wt" && git stash push -q -u -m "coordinator: uncommitted work for lease ${slug} at ${ts}" -- . ':(exclude).term/coordinator/state.json') || {
    printf 'error: could not stash uncommitted work in %s; leaving the worktree in place\n' "$wt" >&2
    return 1
  }
  sha=$(git -C "$wt" rev-parse refs/stash 2>/dev/null || true)
  if [ -z "${sha:-}" ]; then
    printf 'error: stash produced no commit for %s; leaving the worktree in place\n' "$wt" >&2
    return 1
  fi
  git -C "$wt" update-ref "$ref" "$sha" || {
    printf 'error: could not pin %s; leaving the worktree in place\n' "$ref" >&2
    return 1
  }
  printf 'warning: preserved uncommitted work from %s\n' "$wt" >&2
  printf '  ref: %s (%s)\n' "$ref" "$sha" >&2
  printf '  recover: git stash apply %s\n' "$ref" >&2
  printf '       or: git branch recover-%s-%s %s && git stash apply recover-%s-%s\n' "$slug" "$ts" "$ref" "$slug" "$ts" >&2
  return 0
}

# Remove a linked worktree without ever destroying uncommitted bytes. Only the
# sanctioned .term/coordinator/state.json dirt may be lost.
safe_remove_worktree() {
  local wt="$1" slug="$2" reason="${3:-cleanup}"
  [ -d "$wt" ] || return 0
  local dirty
  dirty=$(git -C "$wt" status --porcelain -- . ':(exclude).term/coordinator/state.json' 2>/dev/null || true)
  if [ -n "$dirty" ]; then
    preserve_dirt "$wt" "$slug" || return 1
  fi
  # Remaining dirt (if any) is the exempt state.json record; plain remove first,
  # force only as a last resort — bytes are already safe by now.
  git -C "$MAIN_ROOT" worktree remove "$wt" >/dev/null 2>&1 || git -C "$MAIN_ROOT" worktree remove --force "$wt" >/dev/null 2>&1 || {
    printf 'warning: could not remove worktree %s; left in place\n' "$wt" >&2
    return 1
  }
  return 0
}

# Give a worktree a usable node_modules: its own install if present, else a
# checked symlink to the main checkout's. Dangling symlinks are replaced, never
# left silently. Best-effort: warns, never fails the caller.
ensure_node_modules() {
  local wt="$1"
  [ -d "$wt" ] || return 0
  if [ -e "$wt/node_modules" ] && [ ! -L "$wt/node_modules" ]; then
    return 0 # a real directory (its own install); leave it alone
  fi
  if [ -L "$wt/node_modules" ]; then
    if [ -d "$wt/node_modules" ]; then
      return 0 # healthy symlink
    fi
    rm -f "$wt/node_modules" # dangling — remove it here, never mid-merge
  fi
  if [ -d "$MAIN_ROOT/node_modules" ]; then
    ln -s "$MAIN_ROOT/node_modules" "$wt/node_modules" 2>/dev/null && return 0
    printf 'warning: could not symlink node_modules into %s\n' "$wt" >&2
    return 0
  fi
  if command -v bun >/dev/null 2>&1; then
    (cd "$wt" && bun install --frozen-lockfile >/dev/null 2>&1) || (cd "$wt" && bun install >/dev/null 2>&1) || \
      printf 'warning: bun install failed in %s; run it before merging\n' "$wt" >&2
  fi
}

paths_overlap() {
  local a="$1" b="$2"
  [ -z "$a" ] && return 1
  [ -z "$b" ] && return 1
  local aa bb
  aa=$(printf '%s' "$a" | sed 's:/*$::')
  bb=$(printf '%s' "$b" | sed 's:/*$::')
  case "$aa" in
    "$bb"|"$bb"/*) return 0 ;;
  esac
  case "$bb" in
    "$aa"|"$aa"/*) return 0 ;;
  esac
  return 1
}

check_overlap() {
  need_jq
  local new_paths="$1"
  local cur_slug="${2:-}"
  local force="${3:-0}"
  [ -z "$new_paths" ] && return 0
  local others other other_paths
  others=$(jq -r '.leases | keys[] // empty' "$STATE_FILE" 2>/dev/null || true)
  local other
  for other in $others; do
    [ "$other" = "$cur_slug" ] && continue
    other_paths=$(jq -r --arg o "$other" '.leases[$o].paths // empty' "$STATE_FILE" 2>/dev/null || true)
    [ -z "$other_paths" ] && continue
    # overlap is only advisory against *live* leases; done leases never block a claim
    local other_status
    other_status=$(jq -r --arg o "$other" '.leases[$o].status // "claimed"' "$STATE_FILE" 2>/dev/null || printf 'claimed')
    [ "$other_status" = "done" ] && continue
    local -a n_arr o_arr raw
    local p q tok
    n_arr=()
    IFS=$', \t\n' read -r -a raw <<<"$new_paths"
    for tok in "${raw[@]}"; do tok="$(trim "$tok")"; [ -n "$tok" ] && n_arr+=("$tok"); done
    o_arr=()
    IFS=$', \t\n' read -r -a raw <<<"$other_paths"
    for tok in "${raw[@]}"; do tok="$(trim "$tok")"; [ -n "$tok" ] && o_arr+=("$tok"); done
    for p in "${n_arr[@]}"; do
      for q in "${o_arr[@]}"; do
        if paths_overlap "$p" "$q"; then
          if [ "$force" = "1" ]; then
            printf 'warning: path overlap with %s (forced)\n' "$other" >&2
            return 0
          fi
          printf 'error: path overlap with %s; use --force to claim anyway\n' "$other" >&2
          return 1
        fi
      done
    done
  done
  return 0
}

# Coarse semantic module for a repo-relative path. Two leases that touch different files of the same module share an
# API/test surface even when no declared path literally overlaps — surface that as a warning, never a blocker.
module_of() {
  local p="${1%/}"
  case "$p" in
    src/core/*) printf 'src/core' ;;
    src/runtime/*) printf 'src/runtime' ;;
    src/tui*|tui.ts|dist/tui.js) printf 'src/tui' ;;
    src/*) printf 'src/other' ;;
    scripts/*) printf 'scripts' ;;
    packages/coordinator/*) printf 'packages/coordinator' ;;
    packages/*) printf 'packages/other' ;;
    bin/*) printf 'bin' ;;
    test/*) printf 'test' ;;
    docs/*) printf 'docs' ;;
    .term/*) printf '.term' ;;
    *.md|*.json|*.html|LICENSE) printf 'root-docs' ;;
    *) printf 'root-other' ;;
  esac
}

# De-duplicated, space-separated module list for a comma/space separated path scope.
modules_of_paths() {
  local paths="$1" out="" tok m
  local -a raw
  IFS=$', \t\n' read -r -a raw <<<"$paths"
  for tok in "${raw[@]}"; do
    tok="$(trim "$tok")"
    [ -z "$tok" ] && continue
    m=$(module_of "$tok")
    case " $out " in *" $m "*) ;; *) out="${out:+$out }$m" ;; esac
  done
  printf '%s' "$out"
}

do_claim() {
  need_jq
  ensure_state
  read_config
  local task="" agent="" paths="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --help|-h)
        printf 'usage: coordinator claim <task> --agent <you> --paths <scope> [--force]\n'
        return 0 ;;
      --force)
        force=1; shift ;;
      --agent)
        agent="${2:-}"; shift 2 ;;
      --agent=*)
        agent="${1#--agent=}"; shift ;;
      --paths)
        paths="${2:-}"; shift 2 ;;
      --paths=*)
        paths="${1#--paths=}"; shift ;;
      --)
        shift ;;
      -*)
        printf 'warning: unknown flag %s\n' "$1" >&2; shift ;;
      *)
        if [ -z "$task" ]; then task="$1"; else task="$task $1"; fi; shift ;;
    esac
  done
  # canonicalize the scope list: accept comma- and/or whitespace-separated input and store
  # comma-joined. Paths in this repo never contain spaces; a space in --paths used to
  # silently become one bogus scope token, disabling the overlap check for it.
  if [ -n "$paths" ]; then
    local -a _ptoks=() _out_paths=()
    local _p
    IFS=$', \t\n' read -r -a _ptoks <<<"$paths"
    for _p in "${_ptoks[@]}"; do [ -n "$_p" ] && _out_paths+=("$_p"); done
    paths=$(IFS=','; printf '%s' "${_out_paths[*]}")
  fi

  if [ -z "$task" ]; then
    printf 'usage: coordinator claim <task> --agent <you> --paths <scope> [--force]\n' >&2
    exit 1
  fi
  # empty-slug guard: task must contain at least one alphanumeric character
  if ! printf '%s' "$task" | grep -q '[A-Za-z0-9]'; then
    printf 'error: task must contain at least one alphanumeric character (empty slug)\n' >&2
    exit 1
  fi
  local slug branch worktree
  slug=$(slugify "$task")
  if [ -z "$slug" ]; then
    printf 'error: empty slug for task\n' >&2
    exit 1
  fi
  branch="wt/$slug"
  worktree="$WORKTREE_DIR/wt-$slug"

  # One mutex for the whole claim: re-read state inside the lock, check, create
  # branch/worktree, and write the lease. This prevents lost updates.
  state_lock
  release_claim_lock() { state_unlock; trap - EXIT; }
  trap 'release_claim_lock' EXIT

  # guard overwrite: re-checked inside the state lock
  if [ "$force" -eq 0 ]; then
    local exists
    exists=$(jq -r --arg s "$slug" 'if .leases[$s] then "yes" else "no" end' "$STATE_FILE" 2>/dev/null || printf 'no')
    if [ "$exists" = "yes" ]; then
      printf 'error: lease for %s already exists; use --force to overwrite\n' "$slug" >&2
      release_claim_lock
      exit 1
    fi
  fi

  # overlap is a hard error unless --force is given (against live leases only), re-read inside lock
  if ! check_overlap "$paths" "$slug" "$force"; then
    release_claim_lock
    exit 1
  fi

  # create branch wt/<slug> from dev (or HEAD); idempotent but fail hard on error
  if ! git -C "$MAIN_ROOT" show-ref --verify --quiet "refs/heads/$branch"; then
    local base="$DEV_BRANCH"
    if ! git -C "$MAIN_ROOT" show-ref --verify --quiet "refs/heads/$base"; then
      base="HEAD"
    fi
    if ! git -C "$MAIN_ROOT" branch "$branch" "$base" >/dev/null 2>&1; then
      printf 'error: failed to create branch %s from %s\n' "$branch" "$base" >&2
      release_claim_lock
      exit 1
    fi
  fi
  if ! git -C "$MAIN_ROOT" show-ref --verify --quiet "refs/heads/$branch"; then
    printf 'error: branch %s was not created\n' "$branch" >&2
    release_claim_lock
    exit 1
  fi

  # create worktree worktree/wt-<slug>; idempotent but fail hard on error
  mkdir -p "$MAIN_ROOT/$WORKTREE_DIR"
  local wt_path="$MAIN_ROOT/$worktree"
  if [ ! -d "$wt_path" ]; then
    if ! git -C "$MAIN_ROOT" worktree add "$wt_path" "$branch" >/dev/null 2>&1; then
      printf 'error: failed to create worktree %s for branch %s\n' "$wt_path" "$branch" >&2
      release_claim_lock
      exit 1
    fi
  fi
  if [ ! -d "$wt_path" ]; then
    printf 'error: worktree %s was not created\n' "$wt_path" >&2
    release_claim_lock
    exit 1
  fi
  ensure_node_modules "$wt_path"

  local ts
  ts=$(now_iso)
  state_write_filter --arg slug "$slug" --arg agent "$agent" --arg paths "$paths" --arg branch "$branch" --arg worktree "$worktree" --arg ts "$ts" '.leases[$slug] = {agent: $agent, paths: $paths, branch: $branch, worktree: $worktree, status: "claimed", createdAt: $ts}'
  release_claim_lock
  printf 'claimed %s worktree %s\n' "$branch" "$worktree"
}

do_heartbeat() {
  printf 'heartbeat ok\n'
}

do_submit() {
  need_jq
  ensure_state
  read_config
  local force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --help|-h)
        printf 'usage: coordinator submit [--force]\n'
        return 0 ;;
      --force)
        force=1; shift ;;
      -*)
        printf 'warning: unknown flag %s\n' "$1" >&2; shift ;;
      *)
        printf 'error: unexpected argument %s\n' "$1" >&2; exit 1 ;;
    esac
  done
  local cur slug=""
  cur=$(git branch --show-current 2>/dev/null || printf '')
  if [ -n "$cur" ]; then
    case "$cur" in
      wt/*) slug="${cur#wt/}" ;;
    esac
  fi
  # strict: no wt/<slug> branch, no submit. No fallback lease, no fake lease.
  if [ -z "$slug" ]; then
    printf 'error: submit requires current branch wt/<slug> (claim first, then work in its worktree)\n' >&2
    exit 1
  fi

  local branch expected_worktree cur_worktree_rel
  branch="wt/$slug"
  expected_worktree="$WORKTREE_DIR/wt-$slug"
  cur_worktree_rel="${ROOT#$MAIN_ROOT/}"
  [ "$cur_worktree_rel" = "$ROOT" ] && cur_worktree_rel=""

  # Re-read lease state inside the lock before deciding; refuse stale/wrong ownership.
  state_lock
  release_submit_lock() { state_unlock; trap - EXIT; }
  trap 'release_submit_lock' EXIT
  local status lease_branch lease_worktree lease_agent claimed_paths
  status=$(jq -r --arg s "$slug" '.leases[$s].status // empty' "$STATE_FILE" 2>/dev/null || true)
  lease_branch=$(jq -r --arg s "$slug" '.leases[$s].branch // empty' "$STATE_FILE" 2>/dev/null || true)
  lease_worktree=$(jq -r --arg s "$slug" '.leases[$s].worktree // empty' "$STATE_FILE" 2>/dev/null || true)
  warn_legacy_lease_path "$lease_worktree"
  lease_agent=$(jq -r --arg s "$slug" '.leases[$s].agent // empty' "$STATE_FILE" 2>/dev/null || true)
  claimed_paths=$(jq -r --arg s "$slug" '.leases[$s].paths // ""' "$STATE_FILE" 2>/dev/null || printf '')
  if [ -z "$status" ]; then
    printf 'error: no claimed lease for %s (run claim first)\n' "$slug" >&2
    release_submit_lock
    exit 1
  fi
  if [ "$status" != "claimed" ]; then
    printf 'error: lease for %s is %s, expected claimed\n' "$slug" "$status" >&2
    release_submit_lock
    exit 1
  fi
  if [ "$lease_branch" != "$branch" ] || { [ -n "$lease_worktree" ] && [ "$lease_worktree" != "$cur_worktree_rel" ] && [ "$lease_worktree" != "$expected_worktree" ]; }; then
    printf 'error: lease %s does not match the current worktree/branch (lease branch=%s worktree=%s agent=%s; current branch=%s worktree=%s)\n' \
      "$slug" "${lease_branch:-<empty>}" "${lease_worktree:-<empty>}" "${lease_agent:-<empty>}" "$branch" "${cur_worktree_rel:-<main>}" >&2
    release_submit_lock
    exit 1
  fi
  release_submit_lock

  # Enforce the lease's claimed paths against the commits on this branch.
  local base
  base=$(git merge-base "$DEV_BRANCH" HEAD 2>/dev/null | head -n1 || true)
  if [ -z "$base" ]; then
    base=$(git rev-list --max-parents=0 HEAD 2>/dev/null | head -n1 || true)
  fi
  local files f violations=()
  if [ -n "$base" ]; then
    files=$(git diff --name-only "$base"...HEAD 2>/dev/null || true)
  else
    files=$(git diff --name-only HEAD~1...HEAD 2>/dev/null || true)
  fi
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    if path_in_scopes "$f" "$claimed_paths"; then continue; fi
    if path_in_scopes "$f" "$SHARED_PATHS"; then continue; fi
    violations+=("$f")
  done <<<"$files"

  local ts files_json="[]"
  ts=$(now_iso)
  if [ "${#violations[@]}" -gt 0 ]; then
    printf 'error: commits on %s touch files outside the claimed paths:\n' "$branch" >&2
    for f in "${violations[@]}"; do printf '  - %s\n' "$f" >&2; done
    printf 'claimed paths: %s\n' "${claimed_paths:-<empty>}" >&2
    printf 'shared paths (always allowed): %s\n' "$SHARED_PATHS" >&2
    if [ "$force" -ne 1 ]; then
      printf 're-run with submit --force to override (the override is logged to the lease record)\n' >&2
      exit 1
    fi
    files_json=$(printf '%s\n' "${violations[@]}" | jq -R . | jq -s .)
    printf 'warning: submit --force: scope override logged to the lease record for %s\n' "$slug" >&2
  fi

  # Uncommitted files never travel in the merge; say so loudly (not fatal).
  local uncommitted
  uncommitted=$(git status --porcelain -- . ':(exclude).term/coordinator/state.json' 2>/dev/null | wc -l | tr -d ' ')
  if [ "${uncommitted:-0}" != "0" ]; then
    printf 'warning: worktree has %s uncommitted file(s); they will NOT be merged. merge-next preserves them in refs/coordinator/saved/%s-<ts>\n' "$uncommitted" "$slug" >&2
  fi

  # Keep the worktree path the lease actually lives at. When the default dir moved to
  # "worktree", an old lease still checked out under "worktrees/" must not be rewritten
  # to a path that does not exist — the legacy fallback keeps old lease paths valid.
  local record_worktree="${cur_worktree_rel:-$expected_worktree}"

  # Final transition is atomic and re-validated under the lock.
  state_lock
  release_submit_lock() { state_unlock; trap - EXIT; }
  trap 'release_submit_lock' EXIT
  status=$(jq -r --arg s "$slug" '.leases[$s].status // empty' "$STATE_FILE" 2>/dev/null || true)
  lease_branch=$(jq -r --arg s "$slug" '.leases[$s].branch // empty' "$STATE_FILE" 2>/dev/null || true)
  lease_worktree=$(jq -r --arg s "$slug" '.leases[$s].worktree // empty' "$STATE_FILE" 2>/dev/null || true)
  warn_legacy_lease_path "$lease_worktree"
  if [ "$status" != "claimed" ] || [ "$lease_branch" != "$branch" ] || { [ -n "$lease_worktree" ] && [ "$lease_worktree" != "$cur_worktree_rel" ] && [ "$lease_worktree" != "$expected_worktree" ]; }; then
    printf 'error: lease %s changed or does not match the current worktree; re-run submit\n' "$slug" >&2
    release_submit_lock
    exit 1
  fi
  if [ "${#violations[@]}" -gt 0 ]; then
    state_write_filter --arg slug "$slug" --arg branch "$branch" --arg worktree "$record_worktree" --arg ts "$ts" --argjson files "$files_json" \
      '.leases[$slug].status = "submitted" | .leases[$slug].submittedAt = $ts | .leases[$slug].branch = $branch | .leases[$slug].worktree = $worktree | .leases[$slug].forcedScope = true | .leases[$slug].forcedScopeAt = $ts | .leases[$slug].forcedScopeFiles = $files'
  else
    state_write_filter --arg slug "$slug" --arg branch "$branch" --arg worktree "$record_worktree" --arg ts "$ts" \
      '.leases[$slug].status = "submitted" | .leases[$slug].submittedAt = $ts | .leases[$slug].branch = $branch | .leases[$slug].worktree = $worktree'
  fi
  release_submit_lock
  printf 'submitted %s\n' "$branch"
}

# --- release --------------------------------------------------------------

# Release a claimed lease that will never be submitted (an idle or abandoned
# claim). The lease flips to done, so it stops blocking overlapping claims and
# stops warning in merge preflight. Nothing is destroyed: uncommitted bytes are
# preserved in refs/coordinator/saved/<slug>-<ts> (the same mechanism every
# worktree removal uses) and a branch with unique commits is kept, never
# deleted. A submitted lease is refused: merge-next lands it, merge-abort
# discards it. Without --force a lease that still holds unsubmitted work is
# refused, because releasing it is a deliberate abandon, not cleanup.
do_release() {
  need_jq
  ensure_state
  read_config
  local slug="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --help|-h)
        printf 'usage: coordinator release <slug> [--force]\n'
        printf '\n  Release a claimed lease that will never be submitted (idle or abandoned claim).\n'
        printf '  Marks the lease done, removes its worktree, keeps uncommitted bytes in\n'
        printf '  refs/coordinator/saved/<slug>-<ts>, and keeps a branch that carries unique\n'
        printf '  commits (prints how to recreate its worktree). Submitted leases leave via\n'
        printf '  merge-next or merge-abort; done leases are already released.\n'
        return 0 ;;
      --force)
        force=1; shift ;;
      -*)
        printf 'error: unknown flag %s\n' "$1" >&2; exit 1 ;;
      *)
        if [ -z "$slug" ]; then slug="$1"; else
          printf 'error: unexpected argument %s\n' "$1" >&2; exit 1
        fi
        shift ;;
    esac
  done
  if [ -z "$slug" ]; then
    printf 'usage: coordinator release <slug> [--force]\n' >&2
    exit 1
  fi
  # accept the branch spelling too: release wt/<slug> == release <slug>
  case "$slug" in
    wt/*) slug="${slug#wt/}" ;;
  esac

  # Re-read and validate under the state lock; mark done atomically before cleanup.
  state_lock
  release_release_lock() { state_unlock; trap - EXIT; }
  trap 'release_release_lock' EXIT
  local status branch wt_rel wt_abs
  status=$(jq -r --arg s "$slug" '.leases[$s].status // empty' "$STATE_FILE" 2>/dev/null || true)
  if [ -z "$status" ]; then
    printf 'error: no lease for %s\n' "$slug" >&2
    release_release_lock
    exit 1
  fi
  if [ "$status" = "done" ]; then
    release_release_lock
    printf 'already done: %s (nothing to release)\n' "$slug"
    return 0
  fi
  if [ "$status" = "submitted" ]; then
    printf 'error: lease %s is submitted; merge it with merge-next or discard it with merge-abort\n' "$slug" >&2
    release_release_lock
    exit 1
  fi

  branch=$(jq -r --arg s "$slug" '.leases[$s].branch // ("wt/" + $s)' "$STATE_FILE" 2>/dev/null || printf 'wt/%s' "$slug")
  wt_rel=$(jq -r --arg s "$slug" --arg d "$WORKTREE_DIR" '.leases[$s].worktree // ($d + "/wt-" + $s)' "$STATE_FILE" 2>/dev/null || printf '%s/wt-%s' "$WORKTREE_DIR" "$slug")
  warn_legacy_lease_path "$wt_rel"
  wt_abs="$MAIN_ROOT/$wt_rel"

  local ahead=0 against
  if git -C "$MAIN_ROOT" show-ref --verify --quiet "refs/heads/$branch"; then
    against="$DEV_BRANCH"
    git -C "$MAIN_ROOT" rev-parse --verify --quiet "$DEV_BRANCH" >/dev/null 2>&1 || against="HEAD"
    ahead=$(git -C "$MAIN_ROOT" rev-list --count "$against..$branch" 2>/dev/null | tr -d ' ' || printf '0')
    [ -z "$ahead" ] && ahead=0
  fi

  local dirty_n=0
  if [ -d "$wt_abs" ]; then
    dirty_n=$(git -C "$wt_abs" status --porcelain -- . ':(exclude).term/coordinator/state.json' 2>/dev/null | wc -l | tr -d ' ')
    [ -z "$dirty_n" ] && dirty_n=0
  fi

  if [ "$ahead" != "0" ] || [ "$dirty_n" != "0" ]; then
    if [ "$force" -ne 1 ]; then
      printf 'error: lease %s holds unsubmitted work (%s commit(s) ahead of %s, %s uncommitted file(s)); submit it, or release --force to abandon it deliberately\n' "$slug" "$ahead" "$against" "$dirty_n" >&2
      printf '  nothing is deleted either way: a branch with commits stays and uncommitted bytes go to refs/coordinator/saved/\n' >&2
      release_release_lock
      exit 1
    fi
  fi

  local ts
  ts=$(now_iso)
  state_write_filter --arg s "$slug" --arg ts "$ts" \
    '.leases[$s].status = "done" | .leases[$s].releasedAt = $ts | .leases[$s].releaseReason = "released"'
  release_release_lock

  if [ -d "$wt_abs" ]; then
    if ! safe_remove_worktree "$wt_abs" "$slug" "released"; then
      printf 'warning: could not remove worktree %s; lease %s is marked done\n' "$wt_rel" "$slug" >&2
    fi
  fi

  printf 'released %s (status done)\n' "$slug"
  if [ "$ahead" != "0" ]; then
    printf 'kept branch %s (%s commit(s) ahead of %s)\n' "$branch" "$ahead" "$against"
    printf 'recover: git -C %s worktree add %s %s\n' "$MAIN_ROOT" "$wt_rel" "$branch"
  elif git -C "$MAIN_ROOT" show-ref --verify --quiet "refs/heads/$branch"; then
    if git -C "$MAIN_ROOT" branch -d "$branch" >/dev/null 2>&1; then
      printf 'removed branch %s (no unique commits)\n' "$branch"
    else
      printf 'kept branch %s (could not delete it safely)\n' "$branch"
    fi
  fi
}

# --- merge ----------------------------------------------------------------

# Module-level state-stash plumbing. The coordinator's own state.json dirt is
# exempt from cleanliness checks (claim/submit leave it dirty by design); the
# trial merge must see the committed copy, so the dirt is stashed for the
# duration and restored afterwards — on success, failure, or review stop.
STATE_STASH=""
restore_state_stash() {
  if [ -n "$STATE_STASH" ] && [ -f "$STATE_STASH" ]; then
    state_lock
    local tmp head_tmp
    tmp=$(mktemp "$DATA_DIR/.state.XXXXXX") || { state_unlock; printf 'error: mktemp failed\n' >&2; return 1; }
    head_tmp=$(mktemp "$DATA_DIR/.state-head.XXXXXX") || { rm -f "$tmp"; state_unlock; printf 'error: mktemp failed\n' >&2; return 1; }
    # Prefer merging pre-merge live snapshot with only concurrent mutations made during merge.
    # $STATE_FILE was reset to HEAD for the trial merge; keys equal to HEAD are not concurrent writes.
    if git -C "$MAIN_ROOT" show HEAD:.term/coordinator/state.json > "$head_tmp" 2>/dev/null; then
      if ! jq -n --slurpfile head "$head_tmp" --slurpfile pre "$STATE_STASH" --slurpfile cur "$STATE_FILE" '
        def h: $head[0];
        def p: $pre[0];
        def c: $cur[0];
        def l: ((h.leases // {}) as $hl | (p.leases // {}) as $pl | (c.leases // {}) as $cl |
          reduce (($hl + $pl + $cl) | keys_unsorted[]) as $k ({};
            if (($cl | has($k)) and (($hl[$k] // null) != ($cl[$k] // null))) then .[$k] = $cl[$k]
            elif ($pl | has($k)) then .[$k] = $pl[$k]
            else . end));
        (p * c) | .version = (c.version // p.version // h.version // 1) | .leases = l | .mergeLock = (if ((h.mergeLock // null) != (c.mergeLock // null)) then c.mergeLock else p.mergeLock end)
      ' > "$tmp"; then
        rm -f "$tmp" "$head_tmp"
        state_unlock
        printf 'error: could not merge %s into %s; stashed live state kept at %s\n' "$STATE_STASH" "$STATE_FILE" "$STATE_STASH" >&2
        return 1
      fi
    else
      # No committed head state; fall back to pre-merge live unioned with current, current wins.
      if ! jq -n --slurpfile cur "$STATE_FILE" --slurpfile pre "$STATE_STASH" \
        '$pre[0] * $cur[0] * {version: ($cur[0].version // $pre[0].version // 1), leases: (($pre[0].leases // {}) * ($cur[0].leases // {})), mergeLock: ($cur[0].mergeLock // $pre[0].mergeLock // null)}' > "$tmp"; then
        rm -f "$tmp" "$head_tmp"
        state_unlock
        printf 'error: could not merge %s into %s; stashed live state kept at %s\n' "$STATE_STASH" "$STATE_FILE" "$STATE_STASH" >&2
        return 1
      fi
    fi
    chmod 644 "$tmp" 2>/dev/null || true
    if ! mv -f "$tmp" "$STATE_FILE"; then
      rm -f "$tmp" "$head_tmp"
      state_unlock
      printf 'error: could not restore %s over %s; stashed live state kept at %s\n' "$STATE_STASH" "$STATE_FILE" "$STATE_STASH" >&2
      return 1
    fi
    rm -f "$head_tmp"
    state_unlock
    rm -f "$STATE_STASH"
  fi
  STATE_STASH=""
  return 0
}

# Verify the main checkout is on dev and tracked-clean (exempt: the coordinator's
# own state.json dirt). Prints nothing on success; exits 1 with a message otherwise.
require_main_clean() {
  local why="${1:-merge}"
  local cur_main
  cur_main=$(git -C "$MAIN_ROOT" branch --show-current 2>/dev/null || printf '')
  if [ "$cur_main" != "$DEV_BRANCH" ]; then
    printf 'error: main checkout is on %s, expected %s; refusing to %s\n' "${cur_main:-<detached>}" "$DEV_BRANCH" "$why" >&2
    printf 'recovery: git -C %s checkout %s\n' "$MAIN_ROOT" "$DEV_BRANCH" >&2
    return 1
  fi
  if ! git -C "$MAIN_ROOT" diff --quiet -- . ':(exclude).term/coordinator/state.json' ||
     ! git -C "$MAIN_ROOT" diff --cached --quiet -- . ':(exclude).term/coordinator/state.json'; then
    printf 'error: uncommitted changes outside .term/coordinator/state.json in %s; commit or stash them first\n' "$MAIN_ROOT" >&2
    printf 'recovery: git -C %s stash push -u -m "before coordinator merge" && coordinator merge-next\n' "$MAIN_ROOT" >&2
    return 1
  fi
  return 0
}

do_merge_next() {
  need_jq
  ensure_state
  read_config
  local review=0 target="" explicit_target=0 wait=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --help|-h)
        printf 'usage: coordinator merge-next [<slug>|--target <slug>] [--review] [--wait]\n'
        printf '\n  --target <slug>  land a specific submitted lease (required to land someone else'"'"'s lease)\n'
        printf '  --review         stop before fast-forwarding dev: merged result stays on the\n'
        printf '                   merge-check-* branch, prints the exact command to finish\n'
        printf '  --wait           await-merge first: poll the existing merge lock until it is free\n'
        return 0 ;;
      --review)
        review=1; shift ;;
      --wait)
        wait=1; shift ;;
      --target)
        target="${2:-}"; explicit_target=1; shift 2 ;;
      --target=*)
        target="${1#--target=}"; explicit_target=1; shift ;;
      -*)
        printf 'error: unknown flag %s\n' "$1" >&2
        exit 1 ;;
      *)
        if [ -z "$target" ]; then target="$1"; explicit_target=1; else
          printf 'error: unexpected argument %s\n' "$1" >&2
          exit 1
        fi
        shift ;;
    esac
  done
  case "$target" in
    wt/*) target="${target#wt/}" ;;
  esac

  local caller_slug=""
  local cur_branch
  cur_branch=$(git -C "$ROOT" branch --show-current 2>/dev/null || printf '')
  case "$cur_branch" in
    wt/*) caller_slug="${cur_branch#wt/}" ;;
  esac

  local slug branch
  if [ -n "$target" ]; then
    slug="$target"
  else
    # Default to the caller's own submitted lease; never land someone else's lease without --target.
    slug="$caller_slug"
    if [ -z "$slug" ]; then
      local any_submitted
      any_submitted=$(jq -r '[.leases | to_entries[] | select(.value.status=="submitted") | .key] | .[0] // empty' "$STATE_FILE" 2>/dev/null || true)
      if [ -n "$any_submitted" ]; then
        printf 'error: merge-next must target a lease explicitly; run from your wt/<slug> worktree or pass --target <slug> (submitted: %s)\n' "$any_submitted" >&2
      else
        printf 'no submitted tasks\n'
      fi
      if [ -n "$any_submitted" ]; then exit 1; else return 0; fi
    fi
  fi

  # Validate target lease (re-read inside lock below as well) and ownership.
  local lease_status
  lease_status=$(jq -r --arg s "$slug" '.leases[$s].status // empty' "$STATE_FILE" 2>/dev/null || true)
  if [ -z "$lease_status" ]; then
    printf 'error: no lease for %s\n' "$slug" >&2
    exit 1
  fi
  if [ "$lease_status" != "submitted" ]; then
    if [ "$explicit_target" -eq 0 ] && [ -z "$caller_slug" ]; then
      printf 'no submitted tasks\n'
      return 0
    fi
    printf 'error: lease %s is %s, expected submitted\n' "$slug" "$lease_status" >&2
    exit 1
  fi
  if [ "$explicit_target" -eq 0 ] && [ "$slug" != "$caller_slug" ]; then
    printf 'error: refusing to land lease %s (not owned by caller); pass --target %s to land it explicitly\n' "$slug" "$slug" >&2
    exit 1
  fi

  branch=$(jq -r --arg s "$slug" '.leases[$s].branch // ("wt/" + $s)' "$STATE_FILE" 2>/dev/null || printf 'wt/%s' "$slug")

  # Thin alias: --wait just drains the existing merge lock via await-merge before the
  # normal merge-next path. The lock is still acquired below under the same flock.
  if [ "$wait" -eq 1 ]; then
    do_await_merge || exit 1
  fi

  # acquire serial lock: flock (when available) plus a mkdir lock dir for visibility
  local lock_dir="$DATA_DIR/.merge-lock"
  local lock_file="$DATA_DIR/.merge-lock-file"
  mkdir -p "$DATA_DIR"
  exec 9<>"$lock_file" || { printf 'error: cannot open merge lock file\n' >&2; exit 1; }
  local epoch started_iso
  epoch=$(now_epoch)
  started_iso=$(now_iso)
  # never overwrite the recorded holder before we own the lock; on contention we only read it
  if command -v flock >/dev/null 2>&1; then
    if ! flock -n 9; then
      local holder
      holder=$(cat "$lock_dir/holder" 2>/dev/null || cat "$lock_file" 2>/dev/null || printf 'unknown')
      printf 'error: merge lock held (%s)\n' "${holder%$'\n'}" >&2
      { exec 9>&-; } 2>/dev/null || true
      exit 1
    fi
  fi
  if ! mkdir "$lock_dir" 2>/dev/null; then
    # stale lock handling: a lock dir older than 60 minutes is reclaimed — and we say exactly what we reclaimed
    if [ -d "$lock_dir" ] && [ -n "$(find "$lock_dir" -maxdepth 0 -mmin +60 2>/dev/null)" ]; then
      local holder reclaimed_age
      holder=$(cat "$lock_dir/holder" 2>/dev/null || cat "$lock_file" 2>/dev/null || printf 'slug=? (no holder was recorded)')
      reclaimed_age=$(( ( $(now_epoch) - $(stat -c %Y "$lock_dir" 2>/dev/null || printf '0') ) / 60 ))
      printf 'warning: reclaiming stale merge lock; it held: %s (lock dir age %s min)\n' "${holder%$'\n'}" "$reclaimed_age" >&2
      # mv is atomic: exactly one contender renames the stale dir aside; the rest fail and exit.
      if mv "$lock_dir" "${lock_dir}.stale.$$" 2>/dev/null; then
        rm -rf "${lock_dir}.stale.$$"
      else
        printf 'error: merge lock held\n' >&2
        { exec 9>&-; } 2>/dev/null || true
        exit 1
      fi
      # the stale holder died without releasing: clear its mergeLock so `doctor` stops failing forever
      # (best-effort; never fail the reclaim over bookkeeping)
      (
        exec 8<>"$DATA_DIR/.state.lock" 2>/dev/null || exit 0
        if command -v flock >/dev/null 2>&1; then flock 8 || exit 0; fi
        _ml_tmp=$(mktemp "$DATA_DIR/.state.XXXXXX" 2>/dev/null) || exit 0
        if jq '.mergeLock = null' "$STATE_FILE" > "$_ml_tmp" 2>/dev/null; then
          chmod 644 "$_ml_tmp" 2>/dev/null || true
          mv "$_ml_tmp" "$STATE_FILE"
        else
          rm -f "$_ml_tmp"
        fi
      ) || true
      if ! mkdir "$lock_dir" 2>/dev/null; then
        printf 'error: merge lock held\n' >&2
        { exec 9>&-; } 2>/dev/null || true
        exit 1
      fi
    else
      local holder
      holder=$(cat "$lock_dir/holder" 2>/dev/null || cat "$lock_file" 2>/dev/null || printf 'unknown')
      printf 'error: merge lock held (%s)\n' "${holder%$'\n'}" >&2
      { exec 9>&-; } 2>/dev/null || true
      exit 1
    fi
  fi
  # we own the lock now: record the holder inside the lock file and the lock dir
  printf 'slug=%s branch=%s pid=%s started=%s\n' "$slug" "$branch" "$$" "$started_iso" > "$lock_file" 2>/dev/null || true
  printf 'slug=%s branch=%s pid=%s started=%s\n' "$slug" "$branch" "$$" "$started_iso" > "$lock_dir/holder" 2>/dev/null || true

  # A wt branch that records only .term/coordinator/state.json lease bookkeeping must merge cleanly
  # through the gate. The state file is exempt from the cleanliness check below (claim/submit leave it
  # dirty by design), but the trial merge refuses path-level when the worktree copy differs from HEAD.
  # Stash the dirt for the duration of the merge and restore it before the lease is recorded done
  # (or on any failure), so the submitted record is never lost.
  local scratch="merge-check-${slug}-${epoch}-$$"
  local merge_wt="$MAIN_ROOT/$WORKTREE_DIR/wt-${scratch}"
  local merge_wt_rel="$WORKTREE_DIR/wt-${scratch}"

  release_merge_lock() {
    restore_state_stash
    if [ -f "$STATE_FILE" ] && command -v jq >/dev/null 2>&1; then
      (
        exec 8<>"$DATA_DIR/.state.lock" 2>/dev/null || exit 0
        if command -v flock >/dev/null 2>&1; then flock 8 || exit 0; fi
        local _tmp
        _tmp=$(mktemp "$DATA_DIR/.state.XXXXXX" 2>/dev/null) || exit 0
        if jq '.mergeLock = null' "$STATE_FILE" > "$_tmp" 2>/dev/null; then
          chmod 644 "$_tmp" 2>/dev/null || true
          mv "$_tmp" "$STATE_FILE"
        else
          rm -f "$_tmp"
        fi
      )
    fi
    rm -f "$lock_file" 2>/dev/null || true
    rm -f "$lock_dir/holder" 2>/dev/null || true
    rmdir "$lock_dir" 2>/dev/null || true
    if command -v flock >/dev/null 2>&1; then flock -u 9 2>/dev/null || true; fi
    { exec 9>&-; } 2>/dev/null || true
    trap - EXIT
    return 0
  }
  # fail(): leave dev untouched, clean up the scratch machinery, print recovery. $1=message, $2=recovery hint (optional)
  fail() {
    printf 'error: %s\n' "$1" >&2
    [ -n "${2:-}" ] && printf 'recovery: %s\n' "$2" >&2
    # remove the merge worktree without ever destroying bytes (it should be clean after --abort; be safe anyway)
    if [ -d "$merge_wt" ]; then
      safe_remove_worktree "$merge_wt" "${scratch}" "failed merge" >/dev/null 2>&1 || true
    fi
    git -C "$MAIN_ROOT" branch -D "$scratch" >/dev/null 2>&1 || true
    release_merge_lock
    exit 1
  }
  trap 'release_merge_lock' EXIT
  trap 'release_merge_lock; exit 143' TERM
  trap 'release_merge_lock; exit 130' INT
  trap 'release_merge_lock; exit 129' HUP
  # Re-read lease inside the state lock and record merge owner atomically.
  state_lock
  lease_status=$(jq -r --arg s "$slug" '.leases[$s].status // empty' "$STATE_FILE" 2>/dev/null || true)
  branch=$(jq -r --arg s "$slug" '.leases[$s].branch // ("wt/" + $s)' "$STATE_FILE" 2>/dev/null || printf 'wt/%s' "$slug")
  if [ "$lease_status" != "submitted" ]; then
    state_write_filter '.mergeLock = null'
    state_unlock
    rm -f "$lock_file" 2>/dev/null || true
    rm -f "$lock_dir/holder" 2>/dev/null || true
    rmdir "$lock_dir" 2>/dev/null || true
    if command -v flock >/dev/null 2>&1; then flock -u 9 2>/dev/null || true; fi
    { exec 9>&-; } 2>/dev/null || true
    trap - EXIT TERM INT HUP
    printf 'error: lease %s is %s, expected submitted\n' "$slug" "${lease_status:-<missing>}" >&2
    exit 1
  fi
  state_write_filter --arg s "$slug" --arg b "$branch" --arg scratch "$scratch" --arg pid "$$" --arg ts "$started_iso" \
    '.mergeLock = {slug: $s, branch: $b, scratch: $scratch, pid: ($pid|tonumber), startedAt: $ts}'
  state_unlock

  # Prune scratch branches from interrupted merges only once they are definitively stale (last commit
  # older than the 60-minute stale-lock window) AND fully contained in dev — i.e. there is nothing
  # left to recover. A scratch not on dev may hold a verified-green merged result whose merge was
  # interrupted; deleting it would discard the advertised recovery path, so keep it.
  local _scratch _ts_now _ts_branch
  _ts_now=$(now_epoch)
  for _scratch in $(git -C "$MAIN_ROOT" branch --format='%(refname:short)' --list 'merge-check-*'); do
    _ts_branch=$(git -C "$MAIN_ROOT" log -1 --format=%ct "$_scratch" 2>/dev/null || printf '0')
    if [ $((_ts_now - _ts_branch)) -gt 3600 ] && git -C "$MAIN_ROOT" merge-base --is-ancestor "$_scratch" "$DEV_BRANCH" 2>/dev/null; then
      git -C "$MAIN_ROOT" branch -D "$_scratch" >/dev/null 2>&1 || true
    fi
  done

  # The main checkout must be on dev and tracked-clean at the start of the merge step.
  if ! require_main_clean "merge"; then
    release_merge_lock
    exit 1
  fi

  if ! git -C "$MAIN_ROOT" show-ref --verify --quiet "refs/heads/$branch"; then
    fail "branch $branch not found" "restore or re-create the branch, then re-run merge-next"
  fi

  # Refuse stale-base leases loudly before any merge work; dev must be untouched on failure.
  local dev_tip merge_base wt_rel wt_abs
  dev_tip=$(git -C "$MAIN_ROOT" rev-parse "$DEV_BRANCH" 2>/dev/null || printf '')
  merge_base=$(git -C "$MAIN_ROOT" merge-base "$DEV_BRANCH" "$branch" 2>/dev/null || printf '')
  if [ -n "$dev_tip" ] && [ -n "$merge_base" ] && [ "$merge_base" != "$dev_tip" ]; then
    wt_rel=$(jq -r --arg s "$slug" '.leases[$s].worktree // empty' "$STATE_FILE" 2>/dev/null || printf "$WORKTREE_DIR/wt-$slug")
    wt_abs="$MAIN_ROOT/$wt_rel"
    fail "lease $slug is stale: merge-base($DEV_BRANCH,$branch) is not $DEV_BRANCH tip (dev moved under it); dev untouched" \
      "git -C $wt_abs fetch && git -C $wt_abs rebase $DEV_BRANCH, resolve conflicts, git -C $wt_abs add <resolved>, git -C $wt_abs rebase --continue, re-run 'bun run check' in $wt_abs, then coordinator merge-next"
  fi

  # Worktree drift guard: a submitted worktree whose HEAD moved past the submitted branch means the agent kept
  # committing after submit — the branch we would merge is not the work it validated. Refuse, dev untouched.
  # Uncommitted bytes are NOT a failure: the existing saved-ref mechanism preserves them (see below); report them.
  wt_rel=$(jq -r --arg s "$slug" '.leases[$s].worktree // empty' "$STATE_FILE" 2>/dev/null || printf '')
  warn_legacy_lease_path "$wt_rel"
  [ -z "$wt_rel" ] && wt_rel="$WORKTREE_DIR/wt-$slug"
  wt_abs="$MAIN_ROOT/$wt_rel"
  if [ -d "$wt_abs" ]; then
    local wt_head br_head loose
    wt_head=$(git -C "$wt_abs" rev-parse HEAD 2>/dev/null || printf '')
    br_head=$(git -C "$MAIN_ROOT" rev-parse "$branch" 2>/dev/null || printf '')
    if [ -n "$wt_head" ] && [ -n "$br_head" ] && [ "$wt_head" != "$br_head" ]; then
      fail "worktree drift for lease $slug: worktree HEAD $wt_head differs from submitted branch $branch tip $br_head; dev untouched" \
        "discard the post-submit commits (git -C $wt_abs reset --hard $branch) then re-run coordinator merge-next; a submitted lease cannot be re-submitted — to land different work, release + re-claim a fresh lease"
    fi
    loose=$(git -C "$wt_abs" status --porcelain 2>/dev/null | grep -v ' \.term/coordinator/state\.json$' | grep -c . || true)
    if [ "${loose:-0}" != "0" ]; then
      printf 'drift: worktree %s has %s uncommitted change(s); they are preserved as a saved ref (never merged)\n' "$wt_rel" "$loose" >&2
    fi
  fi

  # Stash the exempt dirt for the trial merge (see above): the worktree copy must equal HEAD for the
  # merge to touch the file, and the submitted lease record it carries must survive the merge.
  if ! git -C "$MAIN_ROOT" diff --quiet -- .term/coordinator/state.json ||
     ! git -C "$MAIN_ROOT" diff --cached --quiet -- .term/coordinator/state.json; then
    STATE_STASH="$(mktemp "$DATA_DIR/.state-stash.XXXXXX")" || {
      fail "cannot create state stash in $DATA_DIR"
    }
    cp "$STATE_FILE" "$STATE_STASH" || {
      rm -f "$STATE_STASH"
      STATE_STASH=""
      fail "cannot read $STATE_FILE"
    }
    if ! git -C "$MAIN_ROOT" restore --staged --worktree -- .term/coordinator/state.json; then
      rm -f "$STATE_STASH"
      STATE_STASH=""
      fail "cannot reset .term/coordinator/state.json for the merge"
    fi
  fi

  git -C "$MAIN_ROOT" fetch >/dev/null 2>&1 || true

  # Two-phase merge. Phase 1 (here): merge onto a scratch branch inside a DEDICATED worktree
  # (never the main checkout), re-count the SPEC marker on the merged tree, run the gate on the
  # merged result, and only then phase 2: fast-forward dev. --review stops before phase 2.
  if ! git -C "$MAIN_ROOT" branch "$scratch" "$DEV_BRANCH" >/dev/null 2>&1; then
    fail "cannot create scratch branch $scratch"
  fi
  mkdir -p "$MAIN_ROOT/$WORKTREE_DIR"
  if ! git -C "$MAIN_ROOT" worktree add "$merge_wt" "$scratch" >/dev/null 2>&1; then
    fail "cannot create merge worktree $merge_wt" "git -C $MAIN_ROOT branch -D $scratch"
  fi
  ensure_node_modules "$merge_wt"

  if ! git -C "$merge_wt" merge --no-ff --no-edit -m "merge $branch into $DEV_BRANCH" "$branch" >/dev/null 2>&1; then
    git -C "$merge_wt" merge --abort >/dev/null 2>&1 || true
    local wt_path wt_abs
    wt_rel=$(jq -r --arg s "$slug" '.leases[$s].worktree // empty' "$STATE_FILE" 2>/dev/null || printf '%s' "$WORKTREE_DIR/wt-$slug")
    wt_abs="$MAIN_ROOT/$wt_rel"
    fail "merge conflict merging $branch into $DEV_BRANCH (dev untouched)" \
      "resolve in the claimant's worktree: git -C $wt_abs rebase $DEV_BRANCH, git -C $wt_abs add <resolved>, git -C $wt_abs rebase --continue, re-run 'bun run check' there, then coordinator merge-next"
  fi

  # The merged tree is authoritative for shared counters: re-count the SPEC marker now and
  # commit the re-count on the scratch branch, so no agent hand-bumps and the gate trusts it.
  local spec_note="spec-check: not present in the merged tree; marker re-count skipped (non-repo fixture or no scripts/spec-check.ts)"
  if [ "${COORDINATOR_SKIP_SPEC_WRITE:-0}" != "1" ] && command -v bun >/dev/null 2>&1 && [ -f "$merge_wt/scripts/spec-check.ts" ]; then
    if (cd "$merge_wt" && bun scripts/spec-check.ts --write); then
      if ! git -C "$merge_wt" diff --quiet HEAD -- SPEC.md; then
        if git -C "$merge_wt" add SPEC.md && git -C "$merge_wt" commit -q -m "chore(spec): re-count marker on the merged tree"; then
          spec_note="spec-check: SPEC.md marker re-counted and committed on $scratch"
        else
          fail "could not commit the SPEC re-count on $scratch; dev untouched" \
            "inspect the merge worktree $merge_wt (git status), fix the cause, then re-run coordinator merge-next"
        fi
      else
        spec_note="spec-check: SPEC.md marker already accurate on the merged tree"
      fi
    else
      fail "spec-check --write failed in the merged tree (red suite or probe failure); dev untouched" \
        "fix the branch so 'bun test' is green in the merged tree, then re-run coordinator merge-next"
    fi
  fi
  printf '%s\n' "$spec_note"

  # The changelog is pipeline-owned too: regenerate it (and page stamps) on the merged tree and
  # commit the result on the scratch branch, so parallel agents never race docs/changelog.html.
  if [ "${COORDINATOR_SKIP_DOCS_WATCH:-0}" != "1" ] && command -v bun >/dev/null 2>&1 && [ -f "$merge_wt/scripts/docs-watch.ts" ]; then
    local local_docs_out local_docs_rc
    local_docs_out=$(cd "$merge_wt" && bun scripts/docs-watch.ts once 2>&1)
    local_docs_rc=$?
    if [ "$local_docs_rc" -eq 0 ]; then
      if ! git -C "$merge_wt" diff --quiet -- docs/; then
        if git -C "$merge_wt" add docs/ && git -C "$merge_wt" commit -q -m "docs: refresh changelog and stamps on the merged tree"; then
          printf 'docs: changelog and page stamps refreshed on %s\n' "$scratch"
        else
          fail "could not commit the docs refresh on $scratch; dev untouched" \
            "inspect the merge worktree $merge_wt (git status), fix the cause, then re-run coordinator merge-next"
        fi
      else
        printf 'docs: changelog and stamps already accurate on the merged tree\n'
      fi
    else
      printf '%s\n' "$local_docs_out" >&2
      fail "docs-watch once failed in the merged tree; dev untouched" \
        "fix docs freshness in the branch (bun scripts/docs-watch.ts once and commit), then re-run coordinator merge-next"
    fi
  fi

  # Preflight: say, BEFORE the gate runs, what this merge touches and which in-flight leases it invalidates.
  local touched others other ostatus overlap_found=0 semantic_found=0 touched_modules other_modules shared mod agency
  touched=$(git -C "$MAIN_ROOT" diff --name-only "$DEV_BRANCH"..."$scratch" 2>/dev/null || true)
  local touched_count
  touched_count=$(printf '%s' "$touched" | grep -c . || true)
  printf 'preflight: merge touches %s file(s)\n' "${touched_count:-0}"
  printf '%s\n' "$touched" | sed 's/^/  /'
  others=$(jq -r '.leases | to_entries | map(select(.value.status != "done")) | .[].key' "$STATE_FILE" 2>/dev/null || true)
  for other in $others; do
    [ "$other" = "$slug" ] && continue
    ostatus=$(jq -r --arg o "$other" '.leases[$o].status' "$STATE_FILE" 2>/dev/null || printf '?')
    local opaths of agency
    opaths=$(jq -r --arg o "$other" '.leases[$o].paths // ""' "$STATE_FILE" 2>/dev/null || printf '')
    agency=$(jq -r --arg o "$other" '.leases[$o].agent // "?"' "$STATE_FILE" 2>/dev/null || printf '?')
    local f hit=0
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      if path_in_scopes "$f" "$opaths"; then hit=1; break; fi
    done <<<"$touched"
    if [ "$hit" = "1" ]; then
      overlap_found=1
      printf 'preflight: WARNING: lease %s (agent %s, status %s, paths %s) overlaps this merge — it will need a rebase onto %s and a re-run of its checks after this merge lands\n' "$other" "$agency" "$ostatus" "$opaths" "$DEV_BRANCH" >&2
    fi
  done
  [ "$overlap_found" = "0" ] && printf 'preflight: no non-done lease overlaps this merge\n'

  # Semantic risk: a literal path-overlap check cannot see two leases touching different files of the same module
  # (shared APIs, shared test surface). Warn — never block — so the submitting agents know to re-validate.
  touched_modules=$(modules_of_paths "$(printf '%s\n' "$touched" | tr '\n' ',' )")
  for other in $others; do
    [ "$other" = "$slug" ] && continue
    opaths=$(jq -r --arg o "$other" '.leases[$o].paths // ""' "$STATE_FILE" 2>/dev/null || printf '')
    [ -z "$opaths" ] && continue
    agency=$(jq -r --arg o "$other" '.leases[$o].agent // "?"' "$STATE_FILE" 2>/dev/null || printf '?')
    other_modules=$(modules_of_paths "$opaths")
    shared=""
    for mod in $touched_modules; do
      case " $other_modules " in *" $mod "*) shared="${shared:+$shared }$mod" ;; esac
    done
    if [ -n "$shared" ]; then
      semantic_found=1
      printf 'preflight: SEMANTIC-RISK: lease %s (agent %s) shares module(s) %s with this merge; re-run its checks after this merge lands\n' "$other" "$agency" "$shared" >&2
    fi
  done
  [ "$semantic_found" = "0" ] && printf 'preflight: no shared-module semantic risk with active leases\n'

  # The gate runs on the merged result, not on dev's pre-merge HEAD.
  if command -v bun >/dev/null 2>&1; then
    if ! (cd "$merge_wt" && bun run check >/dev/null 2>&1); then
      fail "merged result fails the check; aborting merge (dev untouched)" \
        "fix the branch so 'bun run check' is green in the merged tree (reproduce with: git worktree add /tmp/repro $scratch && cd /tmp/repro && bun run check), then re-run coordinator merge-next"
    fi
  fi

  if [ "$review" -eq 1 ]; then
    printf 'review: merged result verified green on branch %s (worktree %s)\n' "$scratch" "$merge_wt_rel"
    printf 'inspect: git -C %s diff %s...%s\n' "$MAIN_ROOT" "$DEV_BRANCH" "$scratch"
    printf 'finish:  git -C %s merge --ff-only %s && coordinator merge-done %s\n' "$MAIN_ROOT" "$scratch" "$slug"
    printf 'discard: coordinator merge-abort %s\n' "$slug"
    # keep the lease submitted and the scratch branch; the caller finishes with merge-done
    safe_remove_worktree "$merge_wt" "${scratch}" "review" || true
    release_merge_lock
    return 0
  fi

  # Re-verify the main checkout before moving dev (it must be on dev and tracked-clean).
  if ! require_main_clean "fast-forward dev"; then
    printf 'merged result kept on branch %s for manual recovery\n' "$scratch" >&2
    printf 'recovery: git -C %s merge --ff-only %s\n' "$MAIN_ROOT" "$scratch" >&2
    safe_remove_worktree "$merge_wt" "${scratch}" "fast-forward blocked"
    release_merge_lock
    exit 1
  fi
  # Test hook: simulate a fast-forward failure deterministically (never used in production paths).
  if [ "${COORDINATOR_TEST_FF_FAIL:-0}" = "1" ]; then
    printf 'error: cannot fast-forward %s onto the verified merge (COORDINATOR_TEST_FF_FAIL); merged result kept on %s\n' "$DEV_BRANCH" "$scratch" >&2
    printf 'recovery: git -C %s merge --ff-only %s\n' "$MAIN_ROOT" "$scratch" >&2
    safe_remove_worktree "$merge_wt" "${scratch}" "fast-forward blocked"
    release_merge_lock
    exit 1
  fi
  if ! git -C "$MAIN_ROOT" merge --ff-only "$scratch" >/dev/null 2>&1; then
    printf 'error: cannot fast-forward %s onto the verified merge; merged result kept on %s\n' "$DEV_BRANCH" "$scratch" >&2
    printf 'recovery: git -C %s merge --ff-only %s\n' "$MAIN_ROOT" "$scratch" >&2
    safe_remove_worktree "$merge_wt" "${scratch}" "fast-forward blocked"
    release_merge_lock
    exit 1
  fi
  # Post-merge health pass: a lightweight post-condition on the landed tree. The full gate already ran on the
  # merged result before the fast-forward; this checks that dev actually landed clean and the marker is present.
  # It reports problems but never undoes a successful merge.
  local health_dirty health_marker
  health_dirty=$(git -C "$MAIN_ROOT" status --porcelain 2>/dev/null | grep -v ' \.term/coordinator/state\.json$' | grep -v ' \.term/coordinator/\.' | grep -v -F " $WORKTREE_DIR/" | grep -c . || true)
  health_marker=$(grep -o 'spec-check files=[0-9]* tests=[0-9]*' "$MAIN_ROOT/SPEC.md" 2>/dev/null | head -1 || true)
  if [ "${health_dirty:-0}" = "0" ]; then
    printf 'post-merge: health ok (clean tracked tree; %s)\n' "${health_marker:-marker absent}"
  else
    printf 'post-merge: WARNING: %s uncommitted change(s) on %s after landing%s\n' "$health_dirty" "$DEV_BRANCH" "${health_marker:+; $health_marker}" >&2
  fi

  # remove the merge worktree first, then delete the scratch branch (a branch checked out
  # in a linked worktree refuses to be deleted — silently swallowed by `|| true`)
  safe_remove_worktree "$merge_wt" "${scratch}" "merged" || true
  git -C "$MAIN_ROOT" branch -D "$scratch" >/dev/null 2>&1 || true

  finish_merged_lease "$slug" "$branch"
  release_merge_lock
  printf 'merged into %s\n' "$DEV_BRANCH"
}

# Mark a lease done after its scratch branch landed on dev, remove its worktree
# (preserving any uncommitted bytes), delete the wt branch, and commit the
# bookkeeping union of state.json. Shared by merge-next and merge-done.
finish_merged_lease() {
  local slug="$1" branch="$2"
  # Bring back the exempt dirt (it carries this lease's submitted record) before flipping it done.
  restore_state_stash

  local ts
  ts=$(now_iso)
  state_jq --arg s "$slug" --arg ts "$ts" --arg dev "$DEV_BRANCH" '.leases[$s].status = "done" | .leases[$s].mergedAt = $ts | .leases[$s].mergedInto = $dev | .mergeLock = null'
  # best-effort cleanup: remove the worktree and the wt branch so the repo does not fill with merged checkouts
  local wt_rel wt_abs
  wt_rel=$(jq -r --arg s "$slug" '.leases[$s].worktree // empty' "$STATE_FILE" 2>/dev/null || printf '')
  warn_legacy_lease_path "$wt_rel"
  if [ -n "${wt_rel:-}" ]; then
    wt_abs="$MAIN_ROOT/$wt_rel"
    safe_remove_worktree "$wt_abs" "$slug" "merged lease" || true
  fi
  git -C "$MAIN_ROOT" branch -d "$branch" >/dev/null 2>&1 || true
  # Bookkeeping policy: merge-next auto-commits the coordinator state file on dev.
  # Live is the source of truth. When writing the committed copy, only include a committed
  # key if the live file lacks it and its branch still exists and has unmerged commits.
  # Never carry a key whose live status is done/absent (prevents resurrecting dead leases).
  if [ -f "$STATE_FILE" ] && command -v jq >/dev/null 2>&1; then
    state_lock
    local _head_tmp _out_tmp _head_ok=0
    _head_tmp=$(mktemp "$DATA_DIR/.state-head.XXXXXX" 2>/dev/null || mktemp)
    _out_tmp=$(mktemp "$DATA_DIR/.state-union.XXXXXX" 2>/dev/null || mktemp)
    if git -C "$MAIN_ROOT" show HEAD:.term/coordinator/state.json > "$_head_tmp" 2>/dev/null; then
      _head_ok=1
    fi
    if [ "$_head_ok" -eq 1 ]; then
      # Start from live leases (source of truth), mergeLock cleared.
      jq -n --slurpfile live "$STATE_FILE" \
        '$live[0] * {version: ($live[0].version // 1), leases: ($live[0].leases // {}), mergeLock: null}' > "$_out_tmp" 2>/dev/null || cp "$STATE_FILE" "$_out_tmp"
      # Preserve committed-only keys only when safe: branch still exists with unmerged commits,
      # or the committed record is terminal (done) bookkeeping that cannot be chased by merge-next.
      # Never resurrect absent live keys that represent active/claimable work.
      local _k _branch _ahead _kstatus
      while IFS= read -r _k; do
        [ -z "$_k" ] && continue
        if jq -e --arg k "$_k" '.leases[$k]' "$STATE_FILE" >/dev/null 2>&1; then
          continue
        fi
        _kstatus=$(jq -r --arg k "$_k" '.leases[$k].status // empty' "$_head_tmp" 2>/dev/null || printf '')
        _branch=$(jq -r --arg k "$_k" '.leases[$k].branch // ("wt/" + $k)' "$_head_tmp" 2>/dev/null || printf '')
        local _keep=0
        if [ "$_kstatus" = "done" ]; then
          _keep=1
        elif [ -n "$_branch" ] && git -C "$MAIN_ROOT" show-ref --verify --quiet "refs/heads/$_branch"; then
          _ahead=$(git -C "$MAIN_ROOT" rev-list --count "$DEV_BRANCH..$_branch" 2>/dev/null | tr -d ' ' || printf '0')
          [ -z "$_ahead" ] && _ahead=0
          if [ "$_ahead" != "0" ]; then
            _keep=1
          fi
        fi
        if [ "$_keep" -eq 1 ]; then
          local _tmp2
          _tmp2=$(mktemp "$DATA_DIR/.state-union.XXXXXX" 2>/dev/null || mktemp)
          if jq --arg k "$_k" --slurpfile head "$_head_tmp" '.leases[$k] = $head[0].leases[$k]' "$_out_tmp" > "$_tmp2" 2>/dev/null; then
            mv -f "$_tmp2" "$_out_tmp"
          else
            rm -f "$_tmp2"
          fi
        fi
      done < <(jq -r '.leases | keys[]? // empty' "$_head_tmp" 2>/dev/null)
      chmod 644 "$_out_tmp" 2>/dev/null || true
      mv -f "$_out_tmp" "$STATE_FILE" || rm -f "$_out_tmp"
    else
      rm -f "$_out_tmp"
      state_write_filter '.mergeLock = null'
    fi
    rm -f "$_head_tmp"
    state_unlock
  fi
  # The bookkeeping commit must land on DEV_BRANCH only; on any other checkout the union stays as
  # exempt dirt instead of committing to the wrong branch.
  local cur_main
  cur_main=$(git -C "$MAIN_ROOT" branch --show-current 2>/dev/null || printf '')
  if [ "$cur_main" = "$DEV_BRANCH" ] && git -C "$MAIN_ROOT" add -- .term/coordinator/state.json >/dev/null 2>&1; then
    if ! git -C "$MAIN_ROOT" diff --cached --quiet -- .term/coordinator/state.json; then
      if ! git -C "$MAIN_ROOT" commit -q -m "chore(coordinator): record ${slug} lease done after merge" >/dev/null 2>&1; then
        printf 'warning: could not commit .term/coordinator/state.json bookkeeping; it remains as exempt dirt\n' >&2
      fi
    fi
  elif [ "$cur_main" != "$DEV_BRANCH" ]; then
    printf 'warning: main checkout is on %s, expected %s; state.json bookkeeping left as exempt dirt (not committed)\n' "${cur_main:-<detached>}" "$DEV_BRANCH" >&2
  fi
}

# finish a two-phase (--review) merge: dev was already fast-forwarded by hand (or by the caller);
# mark the lease done and clean up. Refuses when dev does not contain the scratch branch.
do_merge_done() {
  need_jq
  ensure_state
  read_config
  local slug="${1:-}"
  if [ -z "$slug" ]; then
    printf 'usage: coordinator merge-done <slug>\n' >&2
    exit 1
  fi
  local status
  status=$(jq -r --arg s "$slug" '.leases[$s].status // empty' "$STATE_FILE" 2>/dev/null || true)
  if [ "$status" != "submitted" ]; then
    printf 'error: lease %s is %s, expected submitted\n' "$slug" "${status:-<missing>}" >&2
    exit 1
  fi
  local branch="wt/$slug"
  local scratch match=""
  local list
  list=$(git -C "$MAIN_ROOT" branch --format='%(refname:short)' --list "merge-check-${slug}-*")
  # accept ANY scratch that turned out to be an ancestor of dev (dev may have been fast-forwarded
  # onto the newest one), not just the alphabetically-oldest leftover
  for scratch in $list; do
    if git -C "$MAIN_ROOT" merge-base --is-ancestor "$scratch" "$DEV_BRANCH" 2>/dev/null; then
      match="$scratch"
      break
    fi
  done
  if [ -n "$match" ]; then
    git -C "$MAIN_ROOT" branch -D "$match" >/dev/null 2>&1 || true
  elif [ -n "$list" ]; then
    printf 'error: no merge-check scratch for %s is contained in %s (found: %s)\n' "$slug" "$DEV_BRANCH" "$(printf '%s' "$list" | tr '\n' ' ')" >&2
    printf 'recovery: git -C %s merge --ff-only <scratch>   (pick one of: %s)\n' "$MAIN_ROOT" "$(printf '%s' "$list" | tr '\n' ' ')" >&2
    exit 1
  fi
  finish_merged_lease "$slug" "$branch"
  printf 'merged into %s\n' "$DEV_BRANCH"
}

# discard a two-phase (--review) merge: delete the scratch branch; lease stays submitted.
do_merge_abort() {
  need_jq
  ensure_state
  read_config
  local slug="${1:-}"
  if [ -z "$slug" ]; then
    printf 'usage: coordinator merge-abort <slug>\n' >&2
    exit 1
  fi
  local scratch wt
  for scratch in $(git -C "$MAIN_ROOT" branch --format='%(refname:short)' --list "merge-check-${slug}-*"); do
    wt="$MAIN_ROOT/$WORKTREE_DIR/wt-${scratch}"
    if [ -d "$wt" ]; then safe_remove_worktree "$wt" "$scratch" "merge-abort" >/dev/null 2>&1 || true; fi
    git -C "$MAIN_ROOT" branch -D "$scratch" >/dev/null 2>&1 || true
    printf 'discarded %s\n' "$scratch"
  done
  printf 'lease %s stays submitted\n' "$slug"
}

# --- visibility -----------------------------------------------------------

# status_json_lease <slug> — emit the per-lease object with dirty-state attached.
status_json_lease() {
  local slug="$1"
  local worktree_rel wt_abs uncommitted merge_in progress
  worktree_rel=$(jq -r --arg s "$slug" '.leases[$s].worktree // ""' "$STATE_FILE" 2>/dev/null)
  wt_abs="$MAIN_ROOT/$worktree_rel"
  uncommitted=$(dirty_count "$wt_abs")
  local lock_slug
  lock_slug=$(merge_lock_slug)
  if [ "$lock_slug" = "$slug" ]; then merge_in=true; else merge_in=false; fi
  jq -c --arg slug "$slug" --arg wt "$wt_abs" --arg un "$uncommitted" --argjson mp "$merge_in" \
    '.leases[$slug] + { worktreePath: $wt, uncommitted: (if $un == "x" then null else ($un|tonumber) end), mergeInProgress: $mp }' "$STATE_FILE"
}

do_status() {
  need_jq
  ensure_state
  read_config
  local json=0 all=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      --all) all=1 ;;
      -h|--help) show_help; return 0 ;;
      *) printf 'unknown status option: %s\n' "$1" >&2; return 1 ;;
    esac
    shift
  done
  if [ "$json" -eq 1 ]; then
    local first=1 slug out="" slugs
    # Summary keeps the full-bus picture even when the default projection hides historic done leases.
    out='{"summary":'
    out="$out$(jq -c '{submitted: ([.leases[] | select(.status=="submitted")] | length), done: ([.leases[] | select(.status=="done")] | length), active: ([.leases[] | select(.status!="done")] | length), total: (.leases | length)}' "$STATE_FILE")"
    out="$out,\"leases\":{"
    if [ "$all" -eq 1 ]; then
      slugs=$(jq -r '.leases | keys[]' "$STATE_FILE" 2>/dev/null || true)
    else
      slugs=$(jq -r '.leases | to_entries[] | select(.value.status != "done") | .key' "$STATE_FILE" 2>/dev/null || true)
    fi
    for slug in $slugs; do
      if [ "$first" -eq 0 ]; then out="$out,"; fi
      first=0
      local lease_json
      lease_json=$(status_json_lease "$slug")
      out="$out\"$slug\":$lease_json"
    done
    out="$out},\"mergeLock\":$(jq '.mergeLock // null' "$STATE_FILE")}"
    printf '%s\n' "$out"
    return 0
  fi
  local submitted done
  submitted=$(jq '[.leases[] | select(.status=="submitted")] | length' "$STATE_FILE" 2>/dev/null || printf '0')
  done=$(jq '[.leases[] | select(.status=="done")] | length' "$STATE_FILE" 2>/dev/null || printf '0')
  local lock_slug
  lock_slug=$(merge_lock_slug)
  if [ -n "$lock_slug" ]; then
    printf 'submitted: %s done: %s merge in progress: %s\n' "$submitted" "$done" "$lock_slug"
  else
    printf 'submitted: %s done: %s\n' "$submitted" "$done"
  fi
}

# FIFO view of submitted leases with a rough ETA. ETA model: mean merge duration of
# past done leases (mergedAt - submittedAt); falls back to 120s; never below 30s.
do_queue() {
  need_jq
  ensure_state
  read_config
  local json=0
  [ "${1:-}" = "--json" ] && json=1
  local avg
  avg=$(jq -r '[ .leases[] | select(.status=="done" and .mergedAt and .submittedAt)
                 | ((.mergedAt|fromdateiso8601) - (.submittedAt|fromdateiso8601)) ]
               | if length > 0 then (add / length | floor) else 120 end' "$STATE_FILE" 2>/dev/null || printf '120')
  [ "${avg:-0}" -lt 30 ] 2>/dev/null && avg=30
  local entries
  entries=$(jq -r '[ .leases | to_entries[] | select(.value.status=="submitted") ]
                   | sort_by(.value.submittedAt // .value.createdAt // "")
                   | to_entries[]
                   | [ (.key + 1),
                       (.value.value.submittedAt // .value.value.createdAt // ""),
                       (.value.value.branch // ("wt/" + .value.key)),
                       (.value.value.agent // "?"),
                       .value.key ]
                   | @tsv' "$STATE_FILE" 2>/dev/null || true)
  if [ "$json" -eq 1 ]; then
    local first=1 body=""
    while IFS=$'\t' read -r pos subm branch agent idx; do
      [ -z "$pos" ] && continue
      local waited eta slug
      slug="$idx"
      [ -z "$slug" ] && slug="${branch#wt/}"
      waited=$(( $(now_epoch) - $(iso_to_epoch "$subm") ))
      [ "$waited" -lt 0 ] && waited=0
      eta=$(( pos * avg ))
      [ "$first" -eq 0 ] && body="$body,"
      first=0
      body="$body{\"position\":$pos,\"slug\":\"$slug\",\"branch\":\"$branch\",\"agent\":\"$agent\",\"submittedAt\":\"$subm\",\"waitedSeconds\":$waited,\"etaSeconds\":$eta}"
    done <<<"$entries"
    printf '{"avgMergeSeconds":%s,"queue":[%s]}\n' "$avg" "$body"
    return 0
  fi
  printf 'merge queue (FIFO, eta assumes %ss per merge):\n' "$avg"
  local n=0
  while IFS=$'\t' read -r pos subm branch agent idx; do
    [ -z "$pos" ] && continue
    n=$((n+1))
    local waited eta
    waited=$(( $(now_epoch) - $(iso_to_epoch "$subm") ))
    [ "$waited" -lt 0 ] && waited=0
    eta=$(( pos * avg ))
    printf '  %s. %s (agent %s, submitted %s, waiting %sm, eta ~%sm)\n' "$pos" "$branch" "$agent" "$subm" "$((waited/60))" "$((eta/60))"
  done <<<"$entries"
  [ "$n" -eq 0 ] && printf '  (empty)\n'
  return 0
}

# Health checks for a repo driven by this coordinator. Exits 1 when any check FAILs.
do_doctor() {
  need_jq
  ensure_state
  read_config
  local fails=0
  say_ok()   { printf 'ok   %s\n' "$1"; }
  say_warn() { printf 'warn %s\n' "$1"; }
  say_fail() { printf 'FAIL %s\n' "$1"; fails=$((fails+1)); }

  # 1. main checkout on dev
  local cur_main
  cur_main=$(git -C "$MAIN_ROOT" branch --show-current 2>/dev/null || printf '')
  if [ "$cur_main" = "$DEV_BRANCH" ]; then say_ok "main checkout on $DEV_BRANCH"; else say_fail "main checkout on ${cur_main:-<detached>}, expected $DEV_BRANCH (recover: git -C $MAIN_ROOT checkout $DEV_BRANCH)"; fi

  # 2. main checkout tracked-clean (exempt: state.json)
  if git -C "$MAIN_ROOT" diff --quiet -- . ':(exclude).term/coordinator/state.json' && git -C "$MAIN_ROOT" diff --cached --quiet -- . ':(exclude).term/coordinator/state.json'; then
    say_ok "main checkout tracked-clean"
  else
    say_fail "main checkout has uncommitted changes outside .term/coordinator/state.json"
  fi

  # 3. worktree inventory vs leases
  local slugs
  slugs=$(jq -r '.leases | keys[]' "$STATE_FILE" 2>/dev/null || true)
  local done_dangling=0 live_missing=0
  for slug in $slugs; do
    local lstatus wtrel wtabs
    lstatus=$(jq -r --arg s "$slug" '.leases[$s].status // "claimed"' "$STATE_FILE" 2>/dev/null)
    wtrel=$(jq -r --arg s "$slug" '.leases[$s].worktree // ""' "$STATE_FILE" 2>/dev/null)
    [ -z "$wtrel" ] && continue
    wtabs="$MAIN_ROOT/$wtrel"
    if [ "$lstatus" = "done" ]; then
      if [ -d "$wtabs" ]; then
        done_dangling=$((done_dangling+1))
        say_fail "done lease $slug still has worktree $wtrel (leftover; inspect, then: git -C $MAIN_ROOT worktree remove $wtabs)"
      fi
    else
      if [ ! -d "$wtabs" ]; then
        live_missing=$((live_missing+1))
        say_fail "live lease $slug ($lstatus) has no worktree at $wtrel"
      else
        local un
        un=$(dirty_count "$wtabs")
        [ "$un" != "0" ] && [ "$un" != "x" ] && say_warn "live lease $slug has $un uncommitted file(s) in $wtrel"
      fi
    fi
  done
  [ "$done_dangling" -eq 0 ] && say_ok "no done lease retains its worktree"
  [ "$live_missing" -eq 0 ] && say_ok "all live leases have their worktrees"

  # 4. node_modules: dangling symlinks in any worktree
  local dangling=0
  while IFS= read -r wtline; do
    case "$wtline" in worktree\ *) ;; *) continue ;; esac
    local wt="${wtline#worktree }"
    if [ -L "$wt/node_modules" ] && [ ! -d "$wt/node_modules" ]; then
      dangling=$((dangling+1))
      say_fail "dangling node_modules symlink in $wt"
    fi
  done < <(git -C "$MAIN_ROOT" worktree list --porcelain 2>/dev/null)
  [ "$dangling" -eq 0 ] && say_ok "no dangling node_modules symlinks"

  # 5. SPEC marker vs reality
  if [ -f "$MAIN_ROOT/scripts/spec-check.ts" ] && command -v bun >/dev/null 2>&1; then
    if (cd "$MAIN_ROOT" && bun scripts/spec-check.ts >/dev/null 2>&1); then
      say_ok "SPEC.md spec-check marker matches reality"
    else
      say_fail "SPEC.md spec-check marker does not match reality (run: bun scripts/spec-check.ts --write)"
    fi
  else
    say_warn "scripts/spec-check.ts not found; marker check skipped"
  fi

  # 6. merge lock health
  local lock_slug
  lock_slug=$(merge_lock_slug)
  if [ -n "$lock_slug" ]; then
    local scratch_exists
    scratch_exists=$(git -C "$MAIN_ROOT" branch --list "merge-check-${lock_slug}-*" | head -1)
    if [ -n "$scratch_exists" ]; then
      say_warn "merge in progress (lock held by $lock_slug, scratch $scratch_exists) — if this is stale, it will be reclaimed on the next merge-next"
    else
      say_fail "mergeLock held by $lock_slug but no merge-check-${lock_slug}-* branch exists; a merge died mid-flight (state: mergeLock). Set mergeLock to null via: jq '.mergeLock = null' $STATE_FILE > $STATE_FILE.tmp && mv $STATE_FILE.tmp $STATE_FILE"
    fi
  else
    say_ok "no merge lock held"
  fi

  printf 'doctor: %s failure(s)\n' "$fails"
  [ "$fails" -eq 0 ]
}

do_migrate_worktree_dir() {
  need_jq
  ensure_state
  read_config
  local legacy="worktrees" target="$WORKTREE_DIR" dry=0 compat=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      --with-live-leases) compat=1; shift ;;
      -h|--help)
        printf 'usage: coordinator migrate-worktree-dir [--dry-run] [--with-live-leases]\n\n  Move the legacy worktrees/ directory to the configured worktree dir (default worktree/), repair git worktree records, and rewrite config/lease paths. By default it refuses while a live lease still uses the legacy dir. --with-live-leases moves the directory anyway and leaves a worktrees -> worktree compatibility symlink so those leases keep resolving at their old paths (their lease records are left untouched).\n'
        return 0 ;;
      *) printf 'unknown migrate-worktree-dir option: %s\n' "$1" >&2; return 1 ;;
    esac
  done
  if [ "$target" = "$legacy" ]; then
    printf 'error: coordinator still selects legacy "%s"; set worktreeDir to "worktree" first\n' "$legacy" >&2
    return 1
  fi
  local src="$MAIN_ROOT/$legacy" dst="$MAIN_ROOT/$target"
  if [ ! -d "$src" ] || [ -L "$src" ]; then
    printf 'error: no legacy worktree dir at %s (nothing to migrate)\n' "$src" >&2
    return 1
  fi
  # Never disturb another session's live worktree: refuse by default. With the explicit
  # compatibility flag, move the directory but keep the old path alive via a symlink and
  # leave those lease records pointing at the path that still works for their owner.
  local blockers
  blockers=$(jq -r --arg d "$legacy/" '.leases | to_entries[] | select(.value.status != "done") | select((.value.worktree // "") | startswith($d)) | .key' "$STATE_FILE" 2>/dev/null || true)
  if [ -n "$blockers" ] && [ "$compat" -eq 0 ]; then
    printf 'error: active leases still use %s/: %s\n' "$legacy" "$(printf '%s' "$blockers" | tr '\n' ' ')" >&2
    printf 'recovery: let those leases merge/release, then re-run migrate-worktree-dir (or use --with-live-leases to keep their old paths working via a symlink)\n' >&2
    return 1
  fi
  if [ "$dry" -eq 1 ]; then
    printf 'dry-run: would move %s -> %s and rewrite config/lease paths\n' "$src" "$dst"
    return 0
  fi
  # The destination may already exist (new-style leases claimed before the move).
  if [ -d "$dst" ]; then
    if find "$src" -mindepth 1 -maxdepth 1 -exec mv -t "$dst" {} + 2>/dev/null; then
      rmdir "$src" 2>/dev/null || true
    else
      printf 'error: failed to move legacy worktree contents into %s\n' "$dst" >&2
      return 1
    fi
  elif ! mv "$src" "$dst"; then
    printf 'error: failed to move %s to %s\n' "$src" "$dst" >&2
    return 1
  fi
  if [ -n "$blockers" ] && [ "$compat" -eq 1 ] && [ ! -e "$src" ]; then
    ln -s "$target" "$src" 2>/dev/null || printf 'warning: could not create %s -> %s compatibility symlink\n' "$legacy" "$target" >&2
  fi
  # git records the absolute path of each linked worktree; repair them after the move.
  local -a repair=()
  local wt
  for wt in "$dst"/wt-*; do
    [ -d "$wt" ] && repair+=("$wt")
  done
  if [ ${#repair[@]} -gt 0 ]; then
    if ! git -C "$MAIN_ROOT" worktree repair "${repair[@]}" >/dev/null 2>&1; then
      printf 'warning: git worktree repair failed; verify with: git -C %s worktree list\n' "$MAIN_ROOT" >&2
    fi
  fi
  if [ -f "$CONFIG_FILE" ] && command -v jq >/dev/null 2>&1; then
    local ctmp
    ctmp=$(mktemp "$DATA_DIR/.config.XXXXXX") || ctmp=""
    if [ -n "$ctmp" ] && jq --arg d "$target" '.worktreeDir = $d' "$CONFIG_FILE" > "$ctmp" 2>/dev/null; then
      chmod 644 "$ctmp" 2>/dev/null || true
      mv -f "$ctmp" "$CONFIG_FILE"
    else
      [ -n "$ctmp" ] && rm -f "$ctmp"
    fi
  fi
  # Leave blocked leases on their old (symlinked) path; migrate the rest.
  local blocked_json="[]"
  if [ "$compat" -eq 1 ] && [ -n "$blockers" ]; then
    blocked_json=$(printf '%s\n' "$blockers" | jq -Rsc 'split("\n") | map(select(length > 0))')
  fi
  state_jq --arg old "$legacy/" --arg new "$target/" --argjson blocked "$blocked_json" \
    '.leases |= with_entries(if ((.value.worktree // "") | startswith($old)) and ((.key as $k | $blocked | index($k)) | not) then .value.worktree = ($new + (.value.worktree | ltrimstr($old))) else . end)'
  rm -f "$LEGACY_WARN_FILE" 2>/dev/null || true
  printf 'migrated worktree dir: %s -> %s\n' "$legacy" "$target"
  if [ "$compat" -eq 1 ] && [ -n "$blockers" ]; then
    printf 'compat: %s -> %s symlink kept for live lease(s): %s\n' "$legacy" "$target" "$(printf '%s' "$blockers" | tr '\n' ' ')"
  fi
}

show_help() {
  printf 'usage: coordinator <claim|heartbeat|submit|release|merge-next|merge-done|merge-abort|merge-status|await-merge|migrate-worktree-dir|status|queue|doctor> [--help]\n'
  printf '  claim <task> --agent <you> --paths <scope> [--force]   claim a wt/<slug> lease (existing lease and overlapping live paths need --force)\n'
  printf '  heartbeat                                           liveness check\n'
  printf '  submit [--force]                                    submit the current wt/<slug> claimed lease; commits are checked against the claimed paths (--force overrides, logged to the lease)\n'
  printf '  release <slug> [--force]                            release a claimed lease that will never be submitted (idle or abandoned): done, worktree removed, dirty bytes saved to a ref, a branch with commits kept\n'
  printf '  merge-next [<slug>|--target <slug>] [--review] [--wait]  merge a submitted lease into $DEV_BRANCH via a dedicated merge worktree; --target names a lease from the main repo, --review stops before the fast-forward, --wait drains the merge lock first\n'
  printf '  merge-done <slug>                                   finish a --review merge after dev was fast-forwarded by hand\n'
  printf '  merge-abort <slug>                                  discard a --review merge (scratch branch deleted, lease stays submitted)\n'
  printf '  status [--json] [--all]                             submitted/done counts, or per-lease JSON for active leases (--all includes done) with summary/counts/dirty state\n'
  printf '  queue [--json]                                      submitted leases FIFO with position, wait time and ETA\n'
  printf '  merge-status                                        read-only merge lock view as JSON: mergeInProgress, holder, ageSeconds, recommendation\n'
  printf '  await-merge [--timeout SECONDS]                     poll the existing merge lock until free, then print merge-status JSON (exit 1 on timeout)\n'
  printf '  migrate-worktree-dir [--dry-run] [--with-live-leases]  move legacy worktrees/ to worktree/, repair git records and rewrite config/lease paths\n'
  printf '  doctor                                              health checks: main checkout, worktrees, node_modules, SPEC marker, merge lock\n'
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    claim)
      shift; do_claim "$@" ;;
    heartbeat)
      do_heartbeat ;;
    submit)
      shift; do_submit "$@" ;;
    release)
      shift; do_release "$@" ;;
    merge-next)
      shift; do_merge_next "$@" ;;
    merge-done)
      shift; do_merge_done "$@" ;;
    merge-abort)
      shift; do_merge_abort "$@" ;;
    merge-status)
      shift; do_merge_status "$@" ;;
    await-merge)
      shift; do_await_merge "$@" ;;
    migrate-worktree-dir)
      shift; do_migrate_worktree_dir "$@" ;;
    status)
      shift; do_status "$@" ;;
    queue)
      shift; do_queue "$@" ;;
    doctor)
      shift; do_doctor "$@" ;;
    --help|-h|help|"")
      show_help ;;
    *)
      printf 'unknown command: %s\n' "$cmd" >&2
      show_help >&2
      exit 1 ;;
  esac
}

main "$@"
