#!/usr/bin/env bash
set -uo pipefail

# Coordinator binary: claim/submit/merge-next flow for wt/<slug> work.
# Uses plain git (no GitHub). State lives in .term/coordinator/state.json (main repo).

find_root() {
  git rev-parse --show-toplevel 2>/dev/null || pwd
}

find_main_root() {
  local main
  main=$(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2; exit}')
  if [ -n "${main:-}" ] && [ -d "$main" ]; then
    printf '%s\n' "$main"
  else
    find_root
  fi
}

MAIN_ROOT=$(find_main_root)
ROOT=$(find_root)
DATA_DIR="$MAIN_ROOT/.term/coordinator"
CONFIG_FILE="$DATA_DIR/config.json"
STATE_FILE="$DATA_DIR/state.json"

DEV_BRANCH="dev"
WORKTREE_DIR="worktrees"

read_config() {
  DEV_BRANCH="dev"
  WORKTREE_DIR="worktrees"
  if [ -f "$CONFIG_FILE" ]; then
    if command -v jq >/dev/null 2>&1; then
      DEV_BRANCH=$(jq -r '.devBranch // "dev"' "$CONFIG_FILE" 2>/dev/null || printf 'dev')
      WORKTREE_DIR=$(jq -r '.worktreeDir // "worktrees"' "$CONFIG_FILE" 2>/dev/null || printf 'worktrees')
    else
      local v
      v=$(grep -o '"devBranch"[[:space:]]*:[[:space:]]*"[^"]*"' "$CONFIG_FILE" 2>/dev/null | sed -E 's/.*"devBranch"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/' | head -1)
      [ -n "$v" ] && DEV_BRANCH="$v"
      v=$(grep -o '"worktreeDir"[[:space:]]*:[[:space:]]*"[^"]*"' "$CONFIG_FILE" 2>/dev/null | sed -E 's/.*"worktreeDir"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/' | head -1)
      [ -n "$v" ] && WORKTREE_DIR="$v"
    fi
    [ -z "$DEV_BRANCH" ] && DEV_BRANCH="dev"
    [ -z "$WORKTREE_DIR" ] && WORKTREE_DIR="worktrees"
  fi
}

need_jq() {
  if ! command -v jq >/dev/null 2>&1; then
    printf 'error: jq is required for coordinator state\n' >&2
    exit 1
  fi
}

ensure_state() {
  mkdir -p "$DATA_DIR"
  if [ ! -f "$STATE_FILE" ]; then
    local tmp
    tmp=$(mktemp "$DATA_DIR/.state.XXXXXX") || { printf 'error: mktemp failed\n' >&2; exit 1; }
    printf '{"version":1,"leases":{},"mergeLock":null}\n' > "$tmp" && chmod 644 "$tmp" 2>/dev/null; mv "$tmp" "$STATE_FILE"
  fi
}

# Atomic state write: jq args + filter, STATE_FILE is appended here. Uses mktemp + mv in DATA_DIR.
state_jq() {
  local tmp
  tmp=$(mktemp "$DATA_DIR/.state.XXXXXX") || { printf 'error: mktemp failed\n' >&2; exit 1; }
  if ! jq "$@" "$STATE_FILE" > "$tmp"; then
    rm -f "$tmp"
    printf 'error: failed to update coordinator state\n' >&2
    exit 1
  fi
  chmod 644 "$tmp" 2>/dev/null || true
  mv "$tmp" "$STATE_FILE"
}

slugify() {
  local s
  s=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/-{2,}/-/g')
  if [ -z "$s" ]; then s="task"; fi
  printf '%s' "$s"
}

now_iso() {
  date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf '1970-01-01T00:00:00Z'
}

paths_overlap() {
  local a="$1" b="$2"
  [ -z "$a" ] && return 1
  [ -z "$b" ] && return 1
  local aa bb
  aa=$(printf '%s' "$a" | sed 's:/*$::')
  bb=$(printf '%s' "$b" | sed 's:/*$::')
  case "$aa" in
    "$bb"|"$bb"/*) return 0 ;;
  esac
  case "$bb" in
    "$aa"|"$aa"/*) return 0 ;;
  esac
  return 1
}

check_overlap() {
  need_jq
  local new_paths="$1"
  local cur_slug="${2:-}"
  local force="${3:-0}"
  [ -z "$new_paths" ] && return 0
  local others other other_paths
  others=$(jq -r '.leases | keys[] // empty' "$STATE_FILE" 2>/dev/null || true)
  local other
  for other in $others; do
    [ "$other" = "$cur_slug" ] && continue
    other_paths=$(jq -r --arg o "$other" '.leases[$o].paths // empty' "$STATE_FILE" 2>/dev/null || true)
    [ -z "$other_paths" ] && continue
    # comma-separated scopes: check each pair
    local -a n_arr o_arr raw
    local p q tok
    n_arr=()
    IFS=',' read -r -a raw <<<"$new_paths"
    for tok in "${raw[@]}"; do tok="${tok#"${tok%%[![:space:]]*}"}"; tok="${tok%"${tok##*[![:space:]]}"}"; [ -n "$tok" ] && n_arr+=("$tok"); done
    o_arr=()
    IFS=',' read -r -a raw <<<"$other_paths"
    for tok in "${raw[@]}"; do tok="${tok#"${tok%%[![:space:]]*}"}"; tok="${tok%"${tok##*[![:space:]]}"}"; [ -n "$tok" ] && o_arr+=("$tok"); done
    for p in "${n_arr[@]}"; do
      for q in "${o_arr[@]}"; do
        if paths_overlap "$p" "$q"; then
          if [ "$force" = "1" ]; then
            printf 'warning: path overlap with %s (forced)\n' "$other" >&2
            return 0
          fi
          printf 'error: path overlap with %s; use --force to claim anyway\n' "$other" >&2
          return 1
        fi
      done
    done
  done
  return 0
}

do_claim() {
  need_jq
  ensure_state
  read_config
  local task="" agent="" paths="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --help|-h)
        printf 'usage: coordinator claim <task> --agent <you> --paths <scope> [--force]\n'
        return 0 ;;
      --force)
        force=1; shift ;;
      --agent)
        agent="${2:-}"; shift 2 ;;
      --agent=*)
        agent="${1#--agent=}"; shift ;;
      --paths)
        paths="${2:-}"; shift 2 ;;
      --paths=*)
        paths="${1#--paths=}"; shift ;;
      --)
        shift ;;
      -*)
        printf 'warning: unknown flag %s\n' "$1" >&2; shift ;;
      *)
        if [ -z "$task" ]; then task="$1"; else task="$task $1"; fi; shift ;;
    esac
  done
  if [ -z "$task" ]; then
    printf 'usage: coordinator claim <task> --agent <you> --paths <scope> [--force]\n' >&2
    exit 1
  fi
  # empty-slug guard: task must contain at least one alphanumeric character
  if ! printf '%s' "$task" | grep -q '[A-Za-z0-9]'; then
    printf 'error: task must contain at least one alphanumeric character (empty slug)\n' >&2
    exit 1
  fi
  local slug branch worktree
  slug=$(slugify "$task")
  if [ -z "$slug" ]; then
    printf 'error: empty slug for task\n' >&2
    exit 1
  fi
  branch="wt/$slug"
  worktree="$WORKTREE_DIR/wt-$slug"

  # acquire the claim lock: flock on .claim-lock-file (fd 9) plus mkdir .claim-lock
  # (stale after 60 minutes). Held across the lease check, branch/worktree
  # creation, and state write so parallel claims cannot race; released on all
  # exit paths via the EXIT trap.
  local claim_lock_dir="$DATA_DIR/.claim-lock"
  local claim_lock_file="$DATA_DIR/.claim-lock-file"
  mkdir -p "$DATA_DIR"
  exec 9>"$claim_lock_file" || { printf 'error: cannot open claim lock file\n' >&2; exit 1; }
  if command -v flock >/dev/null 2>&1; then
    if ! flock -n 9; then
      printf 'error: claim lock held\n' >&2
      exec 9>&- 2>/dev/null || true
      exit 1
    fi
  fi
  if ! mkdir "$claim_lock_dir" 2>/dev/null; then
    if [ -d "$claim_lock_dir" ] && [ -n "$(find "$claim_lock_dir" -maxdepth 0 -mmin +60 2>/dev/null)" ]; then
      printf 'warning: removing stale claim lock\n' >&2
      rmdir "$claim_lock_dir" 2>/dev/null || rm -rf "$claim_lock_dir"
      if ! mkdir "$claim_lock_dir" 2>/dev/null; then
        printf 'error: claim lock held\n' >&2
        exec 9>&- 2>/dev/null || true
        exit 1
      fi
    else
      printf 'error: claim lock held\n' >&2
      exec 9>&- 2>/dev/null || true
      exit 1
    fi
  fi
  release_claim_lock() {
    rmdir "$claim_lock_dir" 2>/dev/null || true
    if command -v flock >/dev/null 2>&1; then flock -u 9 2>/dev/null || true; fi
    exec 9>&- 2>/dev/null || true
    trap - EXIT
  }
  trap 'release_claim_lock' EXIT

  # guard overwrite: an existing lease is never silently overwritten (re-checked inside the lock)
  if [ "$force" -eq 0 ]; then
    local exists
    exists=$(jq -r --arg s "$slug" 'if .leases[$s] then "yes" else "no" end' "$STATE_FILE" 2>/dev/null || printf 'no')
    if [ "$exists" = "yes" ]; then
      printf 'error: lease for %s already exists; use --force to overwrite\n' "$slug" >&2
      release_claim_lock
      exit 1
    fi
  fi

  # overlap is a hard error unless --force is given
  if ! check_overlap "$paths" "$slug" "$force"; then
    release_claim_lock
    exit 1
  fi

  # create branch wt/<slug> from dev (or HEAD); idempotent but fail hard on error
  if ! git -C "$MAIN_ROOT" show-ref --verify --quiet "refs/heads/$branch"; then
    local base="$DEV_BRANCH"
    if ! git -C "$MAIN_ROOT" show-ref --verify --quiet "refs/heads/$base"; then
      base="HEAD"
    fi
    if ! git -C "$MAIN_ROOT" branch "$branch" "$base" >/dev/null 2>&1; then
      printf 'error: failed to create branch %s from %s\n' "$branch" "$base" >&2
      release_claim_lock
      exit 1
    fi
  fi
  if ! git -C "$MAIN_ROOT" show-ref --verify --quiet "refs/heads/$branch"; then
    printf 'error: branch %s was not created\n' "$branch" >&2
    release_claim_lock
    exit 1
  fi

  # create worktree worktrees/wt-<slug>; idempotent but fail hard on error
  mkdir -p "$MAIN_ROOT/$WORKTREE_DIR"
  local wt_path="$MAIN_ROOT/$worktree"
  if [ ! -d "$wt_path" ]; then
    if ! git -C "$MAIN_ROOT" worktree add "$wt_path" "$branch" >/dev/null 2>&1; then
      printf 'error: failed to create worktree %s for branch %s\n' "$wt_path" "$branch" >&2
      release_claim_lock
      exit 1
    fi
  fi
  if [ ! -d "$wt_path" ]; then
    printf 'error: worktree %s was not created\n' "$wt_path" >&2
    release_claim_lock
    exit 1
  fi

  local ts
  ts=$(now_iso)
  state_jq --arg slug "$slug" --arg agent "$agent" --arg paths "$paths" --arg branch "$branch" --arg worktree "$worktree" --arg ts "$ts" '.leases[$slug] = {agent: $agent, paths: $paths, branch: $branch, worktree: $worktree, status: "claimed", createdAt: $ts}'
  # keep empty agent/paths as empty strings (no special handling needed)
  release_claim_lock
  printf 'claimed %s worktree %s\n' "$branch" "$worktree"
}

do_heartbeat() {
  printf 'heartbeat ok\n'
}

do_submit() {
  need_jq
  ensure_state
  read_config
  local cur slug=""
  cur=$(git branch --show-current 2>/dev/null || printf '')
  if [ -n "$cur" ]; then
    case "$cur" in
      wt/*) slug="${cur#wt/}" ;;
    esac
  fi
  # strict: no wt/<slug> branch, no submit. No fallback lease, no fake lease.
  if [ -z "$slug" ]; then
    printf 'error: submit requires current branch wt/<slug> (claim first, then work in its worktree)\n' >&2
    exit 1
  fi
  local status
  status=$(jq -r --arg s "$slug" '.leases[$s].status // empty' "$STATE_FILE" 2>/dev/null || true)
  if [ -z "$status" ]; then
    printf 'error: no claimed lease for %s (run claim first)\n' "$slug" >&2
    exit 1
  fi
  if [ "$status" != "claimed" ]; then
    printf 'error: lease for %s is %s, expected claimed\n' "$slug" "$status" >&2
    exit 1
  fi
  local branch worktree ts
  branch="wt/$slug"
  worktree="$WORKTREE_DIR/wt-$slug"
  ts=$(now_iso)
  state_jq --arg slug "$slug" --arg branch "$branch" --arg worktree "$worktree" --arg ts "$ts" '.leases[$slug].status = "submitted" | .leases[$slug].submittedAt = $ts'
  printf 'submitted %s\n' "$branch"
}

do_merge_next() {
  need_jq
  ensure_state
  read_config
  local slug branch
  slug=$(jq -r '.leases | to_entries | map(select(.value.status=="submitted")) | sort_by(.value.createdAt // "") | .[0].key // empty' "$STATE_FILE" 2>/dev/null || true)
  if [ -z "$slug" ]; then
    printf 'no submitted tasks\n'
    return 0
  fi
  branch=$(jq -r --arg s "$slug" '.leases[$s].branch // ("wt/" + $s)' "$STATE_FILE" 2>/dev/null || printf 'wt/%s' "$slug")
  # acquire serial lock: flock (when available) plus a mkdir lock dir for visibility
  local lock_dir="$DATA_DIR/.merge-lock"
  local lock_file="$DATA_DIR/.merge-lock-file"
  mkdir -p "$DATA_DIR"
  # flock the merge lock file if flock is available; hold fd 9 until release
  exec 9>"$lock_file" || { printf 'error: cannot open merge lock file\n' >&2; exit 1; }
  if command -v flock >/dev/null 2>&1; then
    if ! flock -n 9; then
      printf 'error: merge lock held\n' >&2
      exec 9>&- 2>/dev/null || true
      exit 1
    fi
  fi
  if ! mkdir "$lock_dir" 2>/dev/null; then
    # stale lock handling: a lock dir older than 60 minutes is removed and retried once
    if [ -d "$lock_dir" ] && [ -n "$(find "$lock_dir" -maxdepth 0 -mmin +60 2>/dev/null)" ]; then
      printf 'warning: removing stale merge lock\n' >&2
      rmdir "$lock_dir" 2>/dev/null || rm -rf "$lock_dir"
      if ! mkdir "$lock_dir" 2>/dev/null; then
        printf 'error: merge lock held\n' >&2
        exec 9>&- 2>/dev/null || true
        exit 1
      fi
    else
      printf 'error: merge lock held\n' >&2
      exec 9>&- 2>/dev/null || true
      exit 1
    fi
  fi
  release_merge_lock() {
    if [ -f "$STATE_FILE" ] && command -v jq >/dev/null 2>&1; then
      local _tmp
      _tmp=$(mktemp "$DATA_DIR/.state.XXXXXX" 2>/dev/null || mktemp) || true
      if [ -n "${_tmp:-}" ]; then
        if jq '.mergeLock = null' "$STATE_FILE" > "$_tmp" 2>/dev/null; then
          chmod 644 "$_tmp" 2>/dev/null || true
          mv "$_tmp" "$STATE_FILE"
        else
          rm -f "$_tmp"
        fi
      fi
    fi
    rmdir "$lock_dir" 2>/dev/null || true
    # unlock flock and close fd 9 if open
    if command -v flock >/dev/null 2>&1; then flock -u 9 2>/dev/null || true; fi
    exec 9>&- 2>/dev/null || true
    trap - EXIT
  }
  # release on exit: clears mergeLock in state, removes lock dir, unlocks flock on all paths
  trap 'release_merge_lock' EXIT
  # record lock owner in state (atomic)
  state_jq --arg s "$slug" '.mergeLock = $s'

  # drop any stale scratch branches from interrupted merges (best effort)
  git -C "$MAIN_ROOT" branch --list 'merge-check-*' -D >/dev/null 2>&1 || true

  # ensure on dev branch in main worktree
  local cur_main
  cur_main=$(git -C "$MAIN_ROOT" branch --show-current 2>/dev/null || printf '')
  if [ "$cur_main" != "$DEV_BRANCH" ]; then
    if ! git -C "$MAIN_ROOT" checkout "$DEV_BRANCH" >/dev/null 2>&1; then
      printf 'error: cannot checkout %s\n' "$DEV_BRANCH" >&2
      release_merge_lock
      exit 1
    fi
  fi

  if ! git -C "$MAIN_ROOT" show-ref --verify --quiet "refs/heads/$branch"; then
    printf 'error: branch %s not found\n' "$branch" >&2
    release_merge_lock
    exit 1
  fi

  # the main worktree must be clean for a safe merge; refuse otherwise.
  # The coordinator's own state file is exempt: claim/submit leave it dirty by design and merges never touch it.
  if ! git -C "$MAIN_ROOT" diff --quiet -- . ':(exclude).term/coordinator/state.json' ||
     ! git -C "$MAIN_ROOT" diff --cached --quiet -- . ':(exclude).term/coordinator/state.json'; then
    printf 'error: uncommitted changes outside .term/coordinator/state.json in %s; commit or stash them first\n' "$MAIN_ROOT" >&2
    release_merge_lock
    exit 1
  fi

  git -C "$MAIN_ROOT" fetch >/dev/null 2>&1 || true

  # Gate on the merged result, not on dev's pre-merge HEAD. A branch whose merge is the fix
  # for the very staleness the gate detects (e.g. a docs freshness refresh) must not be blocked
  # by the state it repairs. The trial merge happens on a throwaway branch; dev is moved only
  # after the merged result passes the check, and is left untouched on failure.
  local tmp_branch="merge-check-${slug}-$$"
  if ! git -C "$MAIN_ROOT" branch "$tmp_branch" "$DEV_BRANCH" >/dev/null 2>&1; then
    printf 'error: cannot create scratch branch %s\n' "$tmp_branch" >&2
    release_merge_lock
    exit 1
  fi
  if ! git -C "$MAIN_ROOT" checkout "$tmp_branch" >/dev/null 2>&1; then
    git -C "$MAIN_ROOT" branch -D "$tmp_branch" >/dev/null 2>&1 || true
    printf 'error: cannot checkout scratch branch %s\n' "$tmp_branch" >&2
    release_merge_lock
    exit 1
  fi
  if ! git -C "$MAIN_ROOT" merge --no-ff --no-edit -m "merge $branch into $DEV_BRANCH" "$branch" >/dev/null 2>&1; then
    git -C "$MAIN_ROOT" merge --abort >/dev/null 2>&1 || true
    git -C "$MAIN_ROOT" checkout "$DEV_BRANCH" >/dev/null 2>&1 || true
    git -C "$MAIN_ROOT" branch -D "$tmp_branch" >/dev/null 2>&1 || true
    printf 'error: merge failed\n' >&2
    release_merge_lock
    exit 1
  fi
  if command -v bun >/dev/null 2>&1; then
    if ! (cd "$MAIN_ROOT" && bun run check >/dev/null 2>&1); then
      git -C "$MAIN_ROOT" checkout "$DEV_BRANCH" >/dev/null 2>&1 || true
      git -C "$MAIN_ROOT" branch -D "$tmp_branch" >/dev/null 2>&1 || true
      printf 'error: merged result fails the check; aborting merge (dev untouched)\n' >&2
      release_merge_lock
      exit 1
    fi
  fi
  # merged result is green: move dev onto it
  if ! git -C "$MAIN_ROOT" checkout "$DEV_BRANCH" >/dev/null 2>&1; then
    git -C "$MAIN_ROOT" checkout --detach >/dev/null 2>&1 || true
    printf 'error: cannot checkout %s after the merged result passed\n' "$DEV_BRANCH" >&2
    release_merge_lock
    exit 1
  fi
  if ! git -C "$MAIN_ROOT" merge --ff-only "$tmp_branch" >/dev/null 2>&1; then
    printf 'error: cannot fast-forward %s onto the verified merge\n' "$DEV_BRANCH" >&2
    release_merge_lock
    exit 1
  fi
  git -C "$MAIN_ROOT" branch -D "$tmp_branch" >/dev/null 2>&1 || true

  local ts
  ts=$(now_iso)
  state_jq --arg s "$slug" --arg ts "$ts" --arg dev "$DEV_BRANCH" '.leases[$s].status = "done" | .leases[$s].mergedAt = $ts | .leases[$s].mergedInto = $dev | .mergeLock = null'
  # best-effort cleanup: remove the worktree and the wt branch so the repo does not fill with merged checkouts
  local wt_rel
  wt_rel=$(jq -r --arg s "$slug" '.leases[$s].worktree // empty' "$STATE_FILE" 2>/dev/null || printf '')
  if [ -n "${wt_rel:-}" ]; then
    git -C "$MAIN_ROOT" worktree remove --force "$MAIN_ROOT/$wt_rel" >/dev/null 2>&1 || true
  fi
  git -C "$MAIN_ROOT" branch -d "$branch" >/dev/null 2>&1 || true
  release_merge_lock
  printf 'merged into %s\n' "$DEV_BRANCH"
}

do_status() {
  need_jq
  ensure_state
  if [ "${1:-}" = "--json" ]; then
    jq '{leases}' "$STATE_FILE"
    return 0
  fi
  local submitted done
  submitted=$(jq '[.leases[] | select(.status=="submitted")] | length' "$STATE_FILE" 2>/dev/null || printf '0')
  done=$(jq '[.leases[] | select(.status=="done")] | length' "$STATE_FILE" 2>/dev/null || printf '0')
  printf 'submitted: %s done: %s\n' "$submitted" "$done"
}

show_help() {
  printf 'usage: coordinator <claim|heartbeat|submit|merge-next|status|queue> [--help]\n'
  printf '  claim <task> --agent <you> --paths <scope> [--force]   claim a wt/<slug> lease (existing lease and overlapping paths need --force)\n'
  printf '  heartbeat                                           liveness check\n'
  printf '  submit                                              submit the current wt/<slug> claimed lease (strict: exits 1 without one)\n'
  printf '  merge-next                                          merge the oldest submitted lease into $DEV_BRANCH, then remove its worktree and wt/<slug> branch (blocks on test failure)\n'
  printf '  status|queue [--json]                                 show submitted/done counts, or leases as JSON (for parallel sessions)\n'
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    claim)
      shift; do_claim "$@" ;;
    heartbeat)
      do_heartbeat ;;
    submit)
      shift; do_submit "$@" ;;
    merge-next)
      shift; do_merge_next "$@" ;;
    status|queue)
      shift; do_status "$@" ;;
    --help|-h|help|"")
      show_help ;;
    *)
      printf 'unknown command: %s\n' "$cmd" >&2
      show_help >&2
      exit 1 ;;
  esac
}

main "$@"
