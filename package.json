{
  "name": "goal-loop",
  "version": "1.1.0",
  "description": "Claude Code-style /goal for OpenCode v2: set a completion condition and the agent keeps working until it is met.",
  "author": "paumkim",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/paumkim/opencode-goalv2#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paumkim/opencode-goalv2.git"
  },
  "bugs": {
    "url": "https://github.com/paumkim/opencode-goalv2/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "goal",
    "autonomous",
    "agent",
    "loop"
  ],
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    },
    "./rpc": {
      "types": "./rpc.ts",
      "default": "./rpc.ts"
    }
  },
  "files": [
    "index.ts",
    "tui.ts",
    "rpc.ts",
    "src",
    "bin",
    "dist",
    "packages/coordinator/bin/coordinator",
    "packages/coordinator/README.md",
    "install.sh"
  ],
  "engines": {
    "opencode": ">=2.0.29"
  },
  "scripts": {
    "test": "cd test && bun test",
    "typecheck": "tsc --noEmit",
    "e2e": "bun scripts/e2e.ts",
    "check": "tsc --noEmit && (cd test && bun test) && bun run check:dist && bun run compile && bun run check:tui && bun run docs:check && bun run check:spec",
    "check:tui": "bun scripts/tui-load-check.ts ./tui.ts",
    "docs:check": "bun scripts/docs-watch.ts check",
    "check:spec": "bun scripts/spec-check.ts",
    "prepublishOnly": "bun run compile && cd test && bun test",
    "compile": "bun scripts/build.ts",
    "docs:watch": "bun scripts/docs-watch.ts watch",
    "docs:once": "bun scripts/docs-watch.ts once",
    "check:dist": "bun scripts/build.ts --check"
  },
  "dependencies": {
    "string-width": "7.2.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.29",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/client": "2.0.29",
    "@opencode/plugin": "2.0.29",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/bun": "1.4.0",
    "solid-js": "1.9.15",
    "typescript": "5.8.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "maintainers": [
    "paumkim"
  ],
  "bin": {
    "goal-loop": "./bin/goal-loop.mjs",
    "opencode-goal": "./bin/goal-loop.mjs"
  }
}
