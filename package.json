{
  "name": "@el4cteo/opencode-goal",
  "version": "1.0.1",
  "description": "Claude Code-style /goal for OpenCode v2: set a completion condition and the agent keeps working until it is met.",
  "author": "EL4CTEO",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/paumkim/opencode-goalv2#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paumkim/opencode-goalv2.git"
  },
  "bugs": {
    "url": "https://github.com/paumkim/opencode-goalv2/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "goal",
    "autonomous",
    "agent",
    "loop"
  ],
  "exports": {
    ".": "./index.ts",
    "./tui": "./dist/tui.js",
    "./rpc": "./rpc.ts"
  },
  "files": [
    "index.ts",
    "tui.ts",
    "rpc.ts",
    "src",
    "dist",
    "packages/coordinator/bin/coordinator",
    "packages/coordinator/README.md"
  ],
  "engines": {
    "opencode": ">=2.0.29"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "e2e": "bun scripts/e2e.ts",
    "check": "tsc --noEmit && (cd test && bun test) && bun run compile && bun run check:tui && bun run docs:check && bun run check:spec",
    "check:tui": "bun scripts/tui-load-check.ts ./tui.ts",
    "docs:check": "bun scripts/docs-watch.ts check",
    "check:spec": "bun scripts/spec-check.ts",
    "prepublishOnly": "bun run compile && bun test",
    "compile": "bun scripts/build.ts",
    "docs:watch": "bun scripts/docs-watch.ts watch",
    "docs:once": "bun scripts/docs-watch.ts once"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.29",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/client": "2.0.29",
    "@opencode/plugin": "2.0.29",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/bun": "1.4.0",
    "solid-js": "1.9.15",
    "typescript": "5.8.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "maintainers": [
    "paumkim"
  ]
}
